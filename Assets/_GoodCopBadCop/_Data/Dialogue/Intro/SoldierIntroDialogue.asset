%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: SoldierIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: End of rotation. Papers. I cross here twice daily.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: Extended perimeter since the [[whisper:eastern incident]]. Clearance should be on file.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: What eastern incident?
      npcResponse: Above your clearance. Ask your commanding officer.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Your name, for the record.
      npcResponse: No. You get the badge number. Same thing.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 1
    npcLine: This checkpoint runs slower than the eastern one.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: What's coming out of the east?
      npcResponse: Officially, nothing. Unofficially, more goes in than comes back out.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: We're thorough here.
      npcResponse: Thorough isn't slow. Learn that, or end up like the last one.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: Badge number's on the back. Keep moving.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
