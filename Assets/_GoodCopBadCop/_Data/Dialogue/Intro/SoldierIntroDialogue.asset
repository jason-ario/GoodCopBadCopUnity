%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: SoldierIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: "End of rotation. Papers."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: Standard transit through the civilian checkpoint. I cross here twice a day, minimum.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "Extended patrol perimeter since the eastern incident. You should have the clearance on file."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: What eastern incident?
      npcResponse: Above your clearance level. Check with your commanding officer. Keep moving.
      animationTrigger: TalkIdle
    - playerChoiceText: Can I get your name for the record?
      npcResponse: No. You get the badge number. Same thing.
      animationTrigger: TalkLookAway
  - type: 0
    npcLine: "Fifteen men in my unit. We rotate through the civilian sectors on a twelve-hour cycle. Shift handover is at the north post."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: "This checkpoint runs slower than the eastern one. I have timed it. You should know that."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: The processing window needs to be tighter. You're sitting at ninety seconds per pass. Forty is achievable.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "There\u2019s a difference between thorough and slow. You\u2019ll learn it."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: I follow the procedure as designed.
      npcResponse: Then the procedure is inefficient. Write that down.
      animationTrigger: TalkLookAway
    - playerChoiceText: We're thorough here.
      npcResponse: "I noticed. You\u2019ll get faster. Or you won\u2019t."
      animationTrigger: TalkIdle
  - type: 0
    npcLine: Papers. Badge number is on the back of the security card. Don't make me repeat this tomorrow.
    animationTrigger: TalkPoint
    cameraTrigger: 
    wobbleText: 0
    choices: []
