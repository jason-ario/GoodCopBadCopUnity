%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: IaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: You read the last page first. Ia Lomidze, archive librarian.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Fewer readers every day. They all ask what happens next.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Do you tell them?
      npcResponse: Endings are written long before anyone reads them. I tell them that.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Is the archive open?
      npcResponse: Every morning. The smog gets in the pages. I open it anyway.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 1
    npcLine: I've already read past this part. I don't say that to frighten you.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What happens next?
      npcResponse: To you? I wouldn't say. Some things are better as a surprise.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Odd thing to say here.
      npcResponse: Everything odd feels ordinary when the plot requires it.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 0
    npcLine: Go on. Stamp it. You already have.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
