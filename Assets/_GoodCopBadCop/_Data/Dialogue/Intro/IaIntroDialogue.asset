  nodes:
  - type: 0
    npcLine: You have a very interesting lifeline. It's shorter than you think.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I'm just returning. Some stories are better left on the shelf.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: Don't worry about the dust on my coat. We'll all be dust soon.
