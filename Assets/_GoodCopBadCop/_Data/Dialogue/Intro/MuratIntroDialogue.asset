%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: MuratIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Merhaba, officer! Grim day, no? Murat Celik, trader. Textiles, mostly.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Papers, ID, and my lucky chestnut. The bazaar never fully closes.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: People still trade?
      npcResponse: More than ever! Less silk, more batteries and candles.
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: Isn't the road dangerous?
      npcResponse: Every road is dangerous. The dangerous ones lead somewhere interesting.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 1
    npcLine: I live with my son. Three noisy grandchildren.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Is the tea house open?
      npcResponse: Yesterday it was! Samuil's tea is still strong. Some things don't end.
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: You seem very calm.
      npcResponse: Three market crashes, two floods, one very aggressive goat. Perspective!
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 0
    npcLine: Keep the chestnut in mind, officer. Luck is rationed too.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
