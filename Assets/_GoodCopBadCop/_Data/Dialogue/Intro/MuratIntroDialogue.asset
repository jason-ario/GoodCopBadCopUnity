%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: MuratIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Merhaba, Officer! Grim day, no? Murat, trader. Textiles, mostly.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: Papers, ID, and my lucky chestnut. The bazaar never fully closes.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Where does your stock come from?
      npcResponse: Friends on the road. Ask fewer questions and the candles get cheaper, eh?
      npcFollowUp: 
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: What else are you carrying?
      npcResponse: Chestnut, string, a photo of my grandchildren. Dangerous man, Murat!
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 1
    npcLine: After the bazaar, Samuil's tea house. People talk there. I listen.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: What are they saying?
      npcResponse: That the last officer took money. That the next one won't. We'll see!
      npcFollowUp: 
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: You seem very calm.
      npcResponse: Three market crashes, two floods, one very aggressive goat. Perspective!
      npcFollowUp: 
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 0
    npcLine: Keep the chestnut in mind, Officer. Luck is rationed too.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
