  nodes:
  - type: 0
    npcLine: Merhaba, officer! A fine day to be guarding such an important gate,
      no?
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: My ID is right here. I keep it next to my lucky chestnut. Never fails
      me!
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: Don't mind my humming. It's an old song for making the road feel shorter.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices: []
