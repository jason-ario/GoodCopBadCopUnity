%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: GuramIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: Papers. Here. Guram Kopaliani. Parking lot on Rustaveli, twenty-two years there.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: New face at the booth. The last officer was faster. Doesn't matter.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: How long have you been coming through here?
      npcResponse: Three months. Since the first checkpoint went up.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Must be a long shift.
      npcResponse: All my shifts are long. I don't mind long. I mind standing still.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 0
    npcLine: "The lot runs itself \u2014 arrivals, departures, log it, close up, go home. My wife died four years ago. I still look at it when I pass."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I'll keep coming through until there's no more lot to come back from. Permit's current, March expiry.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Are you worried about the lot closing?
      npcResponse: It will close. Everything closes. I'll find something else to stand in front of.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Do you have anyone waiting at home?
      npcResponse: Nobody. Got used to it. House is quieter than the lot, which is saying something.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
