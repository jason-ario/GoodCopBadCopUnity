%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: GuramIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Papers. Here. Guram Kopaliani. Parking lot on Rustaveli, twenty-two years.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: New face. The last officer was faster. Doesn't matter.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: How long coming through?
      npcResponse: Three months. Since the first barrier went up.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Still cars to park?
      npcResponse: Two Volgas and a Party car. The rest stopped coming. I still log them.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 1
    npcLine: I'll keep coming until there's no lot to come back to.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Anyone waiting at home?
      npcResponse: Nobody. Wife died four years ago. House is quieter than the lot.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: What if it closes?
      npcResponse: Everything closes. I'll find something else to stand in front of.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: Stamp it. I mind standing still.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
