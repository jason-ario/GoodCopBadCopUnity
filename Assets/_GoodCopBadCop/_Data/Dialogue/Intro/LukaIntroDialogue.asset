%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: LukaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: "Sorry \u2014 here\u2019s the form. I filled it out but I think I put the wrong date on it."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: "Luka Tsereteli. I\u2019m ten. I live upstairs, in Block C. Fourth floor. With my mum."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "School stopped two weeks ago. My teacher said it was temporary. She hasn\u2019t come back."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: Is your school still open?
      npcResponse: "No. They locked the gates. I waited outside for a while in case someone came. Nobody came."
      animationTrigger: TalkLookDown
    - playerChoiceText: What year are you in?
      npcResponse: "Fourth year. I was supposed to do my reading test this month. I practiced a lot for it."
      animationTrigger: TalkLookAway
  - type: 0
    npcLine: "I live with my mum. My dad is in Varka for work. She keeps trying to call him but the phones don\u2019t connect."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I keep telling myself it's going to be fine. I've been saying that every morning. It helps for about ten minutes.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: "I don\u2019t sleep well. I get up and sit by the window. The street below is always empty."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "My hands keep shaking and I can\u2019t tell if it\u2019s the cold or something else."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: Is there anything that helps?
      npcResponse: Routine. Coming through here is part of it, weirdly. At least this part is predictable.
      animationTrigger: TalkIdle
    - playerChoiceText: You should try to sleep.
      npcResponse: "I know. I just... can\u2019t make my brain quiet enough. I\u2019m working on it."
      animationTrigger: TalkLookDown
  - type: 0
    npcLine: My papers. They're fine. I double-checked after the last time I forgot them.
    animationTrigger: TalkPoint
    cameraTrigger: 
    wobbleText: 0
    choices: []
