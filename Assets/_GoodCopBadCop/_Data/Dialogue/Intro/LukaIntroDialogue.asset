%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: LukaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Sorry, here's the form. Luka Tsereteli. I'm ten. I live upstairs in Block C, fourth floor, with my mum.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: School stopped two weeks ago. My teacher never came back.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Is your school still open?
      npcResponse: No. They locked the gates. I waited outside for a while. Nobody came.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: What year are you in?
      npcResponse: Fourth year. I had my reading test this month. I practiced a lot.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: I live with my mum. My dad's in Varka for work. She keeps trying to call him but the phones don't connect.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: My hands keep shaking, I can't tell if it's the cold or something else. My papers are fine, I double-checked.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Is there anything that helps?
      npcResponse: Routine. Coming through here is part of it, weirdly.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: You should try to sleep.
      npcResponse: I know. I can't make my brain quiet enough. I'm working on it.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
