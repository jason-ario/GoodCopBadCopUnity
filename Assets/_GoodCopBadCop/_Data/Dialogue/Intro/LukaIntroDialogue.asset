%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: LukaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Sorry, here's the form. Luka Tsereteli. I'm ten.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: School stopped two weeks ago. My teacher [[whisper:never came back]].
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Did they close it?
      npcResponse: They locked the gates. I waited outside a while. Nobody came.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: Where do you live?
      npcResponse: Block C, fourth floor, with my mum.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 1
    npcLine: My dad's in Varka for work. Mum keeps calling. The phones don't connect.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What's wrong with your hands?
      npcResponse: They keep shaking. Mum says it's the cold. It's not cold.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: Are you sleeping?
      npcResponse: No. My brain won't go quiet. I'm working on it.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 0
    npcLine: Coming here helps. It's always the same.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
