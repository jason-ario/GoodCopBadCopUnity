%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: ButcherIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Pavle Asatiani. Butcher, end of the market row. Don't stare at the face.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: The bandages bother you? They bother me more. Ask, if you have to.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: What happened to your face?
      npcResponse: Meat grinder. You don't feel it until an hour later.
      npcFollowUp: 
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: Take them off.
      npcResponse: Not here. You'd lose your appetite, and you look underfed already.
      npcFollowUp: 
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 1
    npcLine: My brother's old stall. Ration meat, mostly. Nobody asks what animal.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Where's your brother?
      npcResponse: He cried for a week before he left. Now I'm [[whisper:the one wearing it]].
      npcFollowUp: 
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: What animal?
      npcResponse: Whatever comes in. Keep asking like that and you'll outlast the last one.
      npcFollowUp: 
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 0
    npcLine: Papers. Everything's in order. Mostly.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
