%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: ButcherIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: First shift here? I can always tell. You don't have to mention the face.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Pavle Asatiani. The Butcher. Literally my job, never a nickname. Meat grinder, three years back.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Did it hurt?
      npcResponse: Not how you'd think. You don't feel it till an hour later.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: You went back to work after that?
      npcResponse: Next morning. The cows were already dead.
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 0
    npcLine: I run the stall at the end of the market row. Business is good. People eat when they're scared.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: You'll see me often. Late shifts, after close. Papers are here. Everything's in order.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: I'm not bothered by it.
      npcResponse: Good. Saves us both some time.
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: What does your brother think?
      npcResponse: He cried for a week. I'm the one wearing it.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
