%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: ButcherIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: First shift? I can tell. Don't mention the face.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Pavle Asatiani. The Butcher. My job, not a nickname.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What happened to your face?
      npcResponse: Meat grinder. You feel it an hour later.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: Where's your stall?
      npcResponse: End of the market row. Scared people eat.
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 1
    npcLine: Ration meat, mostly. Nobody asks what animal.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Does your brother help?
      npcResponse: He cried for a week. I'm [[whisper:the one wearing it]].
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: What animal?
      npcResponse: Keep asking questions like that. You'll do fine here.
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 0
    npcLine: Papers. Everything's in order. Mostly.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
