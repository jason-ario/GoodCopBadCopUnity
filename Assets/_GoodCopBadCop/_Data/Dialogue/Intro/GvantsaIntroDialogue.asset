%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: GvantsaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: "Your booth has a hairline crack in the left panel \u2014 wasn't there last week. Gvantsa Edisherashvili. Political science student, before the campus emptied."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: "I've documented changes here since week one \u2014 about four people processed every six minutes."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Why are you documenting that?
      npcResponse: Because nobody else is. If I stop recording, the data disappears.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: That sounds exhausting.
      npcResponse: It keeps me from thinking about everything else. Which is the point.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 0
    npcLine: "I live with my mother and sister \u2014 she wanted to leave, my mother wouldn't. I stayed to keep count. Two notebooks so far."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: "Everyone here looks at their papers, not you \u2014 they've stopped trusting faces. Mine are here, expiry October."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What does that mean to you?
      npcResponse: It means faces are no longer reliable data. Worth noting.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: You're very observant.
      npcResponse: I notice everything. Not always useful. But it's all I have.
      animationTrigger: TalkIdle
      playLaughSfx: 0
