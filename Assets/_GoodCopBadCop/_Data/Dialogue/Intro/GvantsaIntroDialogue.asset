%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: GvantsaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: "Your booth has a hairline crack in the left panel. It was not there
      last week. Gvantsa Edisherashvili. Student, political science \u2014 or I was,
      until the campus emptied."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: I have been documenting changes at this checkpoint since the first week. You process an average of four people every six minutes.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: Why are you documenting that?
      npcResponse: "Because nobody else is. If I stop recording, the data disappears. The data is the only thing that makes sense right now."
      animationTrigger: TalkIdle
    - playerChoiceText: That sounds exhausting.
      npcResponse: It keeps me from thinking about everything else. Which is the point.
      animationTrigger: TalkLookDown
  - type: 0
    npcLine: "I live with my mother and sister. My sister wanted to leave; my mother
      wouldn\u2019t. I stayed to keep count. I have filled two notebooks since this
      started \u2014 the entries are getting shorter, there is less to distinguish
      one day from the next."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "Everyone who comes through here looks at their papers instead of at
      you. They\u2019ve stopped trusting faces. My documents \u2014 expiry is October.
      I verified them this morning."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: What does that mean to you?
      npcResponse: "It means faces are no longer reliable data. That\u2019s worth noting."
      animationTrigger: TalkLookAway
    - playerChoiceText: You're very observant.
      npcResponse: "I notice everything. That\u2019s not always useful. But it\u2019s all I have."
      animationTrigger: TalkIdle
