%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: GvantsaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: New crack, left panel. Gvantsa Edisherashvili, political science student.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Four people every six minutes. I've counted since the barriers went up.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Why count?
      npcResponse: Because nobody else is. If I stop recording, the data disappears.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Isn't that exhausting?
      npcResponse: It keeps me from thinking about everything else. That's the point.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 1
    npcLine: Everyone here looks at papers now, not faces. They've stopped trusting faces.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Meaning what?
      npcResponse: Faces are no longer reliable data. Two notebooks of proof so far.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Who's at home?
      npcResponse: Mother and sister. My sister wanted out. I stayed to count.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 0
    npcLine: Check my stamp. Everyone forgets the stamp.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
