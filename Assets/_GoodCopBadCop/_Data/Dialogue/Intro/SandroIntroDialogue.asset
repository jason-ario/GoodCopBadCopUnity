%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: SandroIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Sorry, I was watching the light on the roof. Sandro Kakhidze, mechanic.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: People bring Ladas they can't replace and ask me to keep them running.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Do you have parts?
      npcResponse: Rarely. There's something hopeful in fixing what shouldn't work anymore.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Busy workshop?
      npcResponse: People bring everything in, or stop coming entirely.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: I left a [[whisper:book on a bench]] this morning.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Who's waiting at home?
      npcResponse: Irakli. He works nights. We mostly meet on the stairs.
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: That's a strange habit.
      npcResponse: Irakli says I make everything a poem. He's not wrong.
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 0
    npcLine: Same papers, different faces. Or the other way around.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
