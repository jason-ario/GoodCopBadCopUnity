  nodes:
  - type: 0
    npcLine: Oh, sorry! I was miles away. Here are my documents, officer.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I was just walking by the river. The way the light hits the ripples
      is incredible.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: Do you ever feel like we're all just characters in a very long novel?
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
