%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: TinaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Greetings, officer. My papers... I mean my documents. Tina Meskhi, accountant. Ledgers and sums. Terribly dull, I promise.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Before you ask, the mask covers old scars. An accident, years ago. Everyone asks, so I save them the trouble.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Do you ever take it off?
      npcResponse: Not for strangers. Though you asked so nicely, officer.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Do you sleep in it?
      npcResponse: The mask protects the face beneath it. Think of it as very committed skincare.
      animationTrigger: TalkCocky
      playLaughSfx: 0
  - type: 0
    npcLine: I live alone near the station. No family to speak of. The ledgers keep me company, and they never ask questions.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: You play the stern gatekeeper convincingly, officer. My permit, December expiry. The ink is from the office.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: I'm just checking papers.
      npcResponse: Of course. And if the checking ever grows tiresome, I am very good with numbers. Discreet ones.
      animationTrigger: TalkCocky
      playLaughSfx: 0
    - playerChoiceText: You see everything as a performance?
      npcResponse: Everything is a performance. The difference is whether you're aware of it.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
