MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: TinaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Greetings, Officer. Tina Meskhi, actress, Rustaveli Theatre. You may applaud later.
    animationTrigger: TalkCocky
    expression: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: Yes, the mask. It covers old scars. Everyone asks, so I answer first.
    animationTrigger: TalkIdle
    expression: Concerned
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: You're hiding something.
      npcResponse: Every actress hides something, Officer. Mine just happens to be the face.
      npcFollowUp: 
      animationTrigger: TalkIdle
      expression: 
      playLaughSfx: 0
    - playerChoiceText: Scars from what?
      npcResponse: A fire backstage, long ago. Nothing contagious. Stop leaning back.
      npcFollowUp: 
      animationTrigger: TalkCocky
      expression: Angry
      playLaughSfx: 0
  - type: 1
    npcLine: The last officer and I had an understanding. He adored a good performance.
    animationTrigger: TalkCocky
    expression: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Are you offering a bribe?
      npcResponse: I'm offering tickets. Front row. What you do with them is your business.
      npcFollowUp: 
      animationTrigger: TalkCocky
      expression: 
      playLaughSfx: 0
    - playerChoiceText: What happened to him?
      npcResponse: He got greedy, then careless. Someone reported him. Not me.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      expression: Concerned
      playLaughSfx: 0
  - type: 0
    npcLine: The house is half empty these days. The show goes on anyway.
    animationTrigger: TalkCocky
    expression: Concerned
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
