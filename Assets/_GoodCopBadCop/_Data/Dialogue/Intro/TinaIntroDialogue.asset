%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: TinaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: "Greetings, officer. My papers \u2014 I mean my documents. Tina Meskhi, performer at the Grand Theater, until recently."
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: The mask is my real face. I've worn it seven years. I don't find it strange anymore.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Are you required to wear it for the show?
      npcResponse: There's no show without the mask. There's no me without it either.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Do you sleep in it?
      npcResponse: The mask protects the face beneath it. Think of it as very committed skincare.
      animationTrigger: TalkCocky
      playLaughSfx: 0
  - type: 0
    npcLine: I live near the station with my producer and two interns. We keep running performances anyway.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: You play the stern gatekeeper convincingly, officer. My permit, December expiry. The paint's from rehearsal.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: I'm just checking papers.
      npcResponse: Yes, that's your line. Very consistent. I respect the commitment.
      animationTrigger: TalkCocky
      playLaughSfx: 0
    - playerChoiceText: You see everything as a performance?
      npcResponse: Everything is a performance. The difference is whether you're aware of it.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
