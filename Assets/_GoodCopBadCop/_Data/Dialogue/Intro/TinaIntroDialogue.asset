%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: TinaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Greetings, officer. Tina Meskhi, accountant. Terribly dull, I promise.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Before you ask, the mask covers old scars. Everyone asks.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Do you ever take it off?
      npcResponse: Not for strangers. Though you asked so nicely, officer.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Do you sleep in it?
      npcResponse: It protects the face beneath. Think of it as very committed skincare.
      animationTrigger: TalkCocky
      playLaughSfx: 0
  - type: 1
    npcLine: You play the stern gatekeeper well. My ink is from the office.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: I'm just checking papers.
      npcResponse: Of course. If it grows tiresome, I'm very good with numbers. Discreet ones.
      animationTrigger: TalkCocky
      playLaughSfx: 0
    - playerChoiceText: Everything's a performance?
      npcResponse: Everything. The difference is whether you're aware of it.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: Ledgers are better company. They never ask questions.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
