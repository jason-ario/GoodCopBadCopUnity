%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: TheGamblerIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Heads or tails? Habit. Bidzina Chkhonia. Cards, mostly.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: I've been timing this checkpoint. The variance is bigger than you'd think.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Why time my checkpoint?
      npcResponse: There's a book on how long new officers last. I hold a position.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Where do you play?
      npcResponse: The Metropol, before it closed. Now a basement. Lower stakes, worse people.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: You have a tell, Officer. I won't say [[whisper:which eye]]. But I'd bet on it.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: How long did the last one last?
      npcResponse: Nineteen days. I had him at twenty. Cost me a good watch.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Gambling's illegal.
      npcResponse: So is half this city now. You'll want to pick which half you enforce.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: Heads. Always heads lately. That worries me.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
