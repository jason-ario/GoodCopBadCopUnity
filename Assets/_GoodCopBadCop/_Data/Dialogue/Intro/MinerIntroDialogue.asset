%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: MinerIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Papers. Diko Kozlov. Coal Face B, east shaft. Thirty years.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I know I'm dirty. Showers at the shaft are out three days.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Will they fix them?
      npcResponse: Used to. Now they tell us to manage. We manage.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Is the work worse now?
      npcResponse: Always hard. Air tastes different down there since the blast.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 1
    npcLine: Eleven hours today. I don't complain.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Why stay?
      npcResponse: My wife. The coal. I don't know anything else.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Doesn't it wear you down?
      npcResponse: It does. Standing still is harder.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 0
    npcLine: Done? Good. Home.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
