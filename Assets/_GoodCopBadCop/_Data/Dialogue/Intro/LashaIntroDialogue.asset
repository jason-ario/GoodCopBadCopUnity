  nodes:
  - type: 0
    npcLine: Move it along, officer. I've got a fare waiting and time is money.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: What, you need to see my teeth too? Just check the damn paper.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: This town is going to hell because everyone's standing around asking
      questions.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
