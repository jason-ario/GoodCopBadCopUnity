%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: LashaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Papers. Lasha Gagua, taxi, western district. Make it quick.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: Nine years on these streets. Then you people closed half the routes.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Watch your tone.
      npcResponse: My tone? Petrol's rationed, Officer. So is my patience.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Who's in your cab lately?
      npcResponse: Half are [[whisper:running for the exits]]. I don't ask. I charge double.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: Last officer had a system. Checked me once, waved me through after.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: What did that cost you?
      npcResponse: A carton of cigarettes a week. Don't look at me like that. Everyone paid.
      npcFollowUp: 
      animationTrigger: TalkCocky
      playLaughSfx: 0
    - playerChoiceText: I'm not him.
      npcResponse: No. He was quicker. And look where it got him.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: City's sick, not dead. Not yet.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
