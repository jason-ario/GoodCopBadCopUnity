%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: LashaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Papers. Lasha Gagua, taxi, western district. Make it quick.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Nine years on these streets. Then your people closed half the routes.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Our people?
      npcResponse: Militsiya, Party, whoever put up these barriers. I don't care which.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Still getting fares?
      npcResponse: Plenty. Half are [[whisper:fleeing to the exits]]. I charge double.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: Last officer had a system. Checked once, waved me through.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: I check everyone the same.
      npcResponse: Sure you do. Do it faster. Petrol's rationed, and so is my patience.
      animationTrigger: TalkCocky
      playLaughSfx: 0
    - playerChoiceText: Got family here?
      npcResponse: Wife and two kids, western block. They stay in. I drive.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: City's sick, not dead. Not yet.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
