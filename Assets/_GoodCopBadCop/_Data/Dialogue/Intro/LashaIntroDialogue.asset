%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: LashaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: "Papers are right here. Lasha Gagua. Taxi driver, western district \u2014 half the routes are blocked now."
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Nine years driving these streets. Used to know every shortcut, before your people closed them.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What do you mean, our people?
      npcResponse: Security, government, whoever put up these barriers. I don't care which box you tick.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Nine years is a long time.
      npcResponse: "Long enough to know when a city's dying versus just sick. This one's still sick \u2014 salvageable."
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: "Wife and two kids in the western block. They stay home, I keep working. Half my fares now are people fleeing to the exits \u2014 I charge double."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: "You're new here. Previous officer had a system \u2014 checked once, waved me through. Papers, permit runs to September."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: I do my job the same for everyone.
      npcResponse: "Sure you do. Do it fast \u2014 I've got a fare waiting and time's still money."
      animationTrigger: TalkCocky
      playLaughSfx: 0
    - playerChoiceText: What kind of system?
      npcResponse: The efficient kind. Respect for everyone's time. You'll learn it. Or you won't.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
