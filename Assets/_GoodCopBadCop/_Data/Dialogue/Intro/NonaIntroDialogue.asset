%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: NonaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: Good evening. You're new. Nona Beridze, census recorder, district eleven. Eleven years.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: My job is knowing who lives where and who's moved. Right now, it's something else.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What do you mean, something else?
      npcResponse: The gaps are larger now. Names that stop appearing. I always cross-reference before closing.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: That sounds like difficult work.
      npcResponse: It requires attention. I'm good at it. Most people find that uncomfortable.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: I live alone. I prefer it, shared spaces complicate the records. I've been through this checkpoint thirty-one times.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I noted your face the moment you sat down. It's simply what I do. Everything's in order.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: You noted my face?
      npcResponse: I note everything. The last officer's face too, and the ones before him.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: That's a little unusual.
      npcResponse: So I've been told. Usually by people whose names I already had written down.
      animationTrigger: TalkIdle
      playLaughSfx: 0
