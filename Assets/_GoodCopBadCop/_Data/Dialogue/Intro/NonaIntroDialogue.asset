%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: NonaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Good evening! You're new. Nona Beridze, [[census recorder]], district eleven.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Since the blast, the State needs to know who's left. Isn't it exciting?
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Exciting?
      npcResponse: Of course! Curfews, checkpoints, empty flats. Everything's finally in motion.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: What caused the blast?
      npcResponse: The State knows. Isn't that enough? Wanting more is how it starts.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 1
    npcLine: That uniform! You wear the State's uniform! ...Forgive me. It makes you sacred.
    animationTrigger: BangOnShutters
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Sacred?
      npcResponse: You carry out its will. If you don't, {{I'll report you}}. Gladly.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: That's a little unusual.
      npcResponse: So I'm told. Usually by people whose names I've since passed along.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 0
    npcLine: Thirty-one crossings, stricter every time. I love that. They're paying attention.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
