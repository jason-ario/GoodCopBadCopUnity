  nodes:
  - type: 0
    npcLine: Good evening. Here are my documents. Everything is in order, as always.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I have all the correct papers. I filed them myself.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: You are new here. I know the names of everyone who has worked this post.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
