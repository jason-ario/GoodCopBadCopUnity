%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: ThePriestIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Hello, brother. Grim morning, but we're still here. Father Shota Eradze.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I've been out since dawn fixing water lines in the east district.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: That's priest's work?
      npcResponse: People need water before they need prayer. I work in that order.
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: Doesn't it wear you out?
      npcResponse: The body tires. The purpose doesn't.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: I keep my papers beside a parishioner's letter. She thanked me for a talk.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What did you tell her?
      npcResponse: Grief and fear sound different from outside. Inside, they feel the same.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: You seem very peaceful.
      npcResponse: Peace is chosen each morning. Today it was easier than yesterday.
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 0
    npcLine: Three brothers left at the seminary. We still visit every family.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
