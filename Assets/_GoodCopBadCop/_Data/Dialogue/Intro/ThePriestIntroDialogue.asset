%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: ThePriestIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Hello, brother. Grim morning, but we're still here. Father Shota Eradze.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: I've been out since dawn fixing water lines in the east district.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: The east is restricted.
      npcResponse: Water doesn't know that. People there still need to drink, brother.
      npcFollowUp: 
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: What's wrong with the water?
      npcResponse: Metal. I tell them to boil it, but I'm not sure that's enough.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: Some families there won't open their doors now. I leave bread on the step.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Is the bread taken?
      npcResponse: Every morning. Nobody ever opens the door to take it.
      npcFollowUp: 
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: Why risk it?
      npcResponse: Grief and fear sound different from outside. Inside, they feel the same.
      npcFollowUp: 
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 0
    npcLine: You carry heavy things in that booth, brother. Come to evening prayers.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
