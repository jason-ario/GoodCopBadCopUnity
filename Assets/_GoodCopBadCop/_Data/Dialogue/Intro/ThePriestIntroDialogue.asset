%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: ThePriestIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Hello, brother. Grim morning, but we're still here. Father Shota Eradze. I serve at the cathedral, mostly the streets.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I've been out since dawn helping with the water lines in the east district.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Water lines? That's not typically a priest's work.
      npcResponse: People need water before they need prayer. I've learned to work in that order.
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: Doesn't it wear you out?
      npcResponse: The body tires. The purpose doesn't. Knowing why I'm moving makes it easy.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 0
    npcLine: I live with the seminary brothers, three of us now. We eat together, pray together, check on parish families in rotation.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I keep my papers next to a letter from a parishioner, thanking me for a talk months ago. Permit runs to December.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What did you say to her?
      npcResponse: Grief and fear sound different from the outside. Inside, they feel the same. She needed to hear that.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: You seem very peaceful for the circumstances.
      npcResponse: Peace has to be chosen each morning. Today it was an easier choice than yesterday.
      animationTrigger: TalkSmile
      playLaughSfx: 0
