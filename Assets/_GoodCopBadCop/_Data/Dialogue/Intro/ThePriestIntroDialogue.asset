%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: ThePriestIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: "Hello, brother. It\u2019s a grim morning, but we\u2019re still here. That counts for something."
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: "Father Shota Eradze. I serve at the Cathedral on the hill, but mostly I work in the streets. Where the people are."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "I\u2019ve been out since dawn helping with the water lines in the east district. There is always something that needs doing. I find that comforting."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: Water lines? That's not typically a priest's work.
      npcResponse: "People need water before they need prayer. I\u2019ve learned to work in that order."
      animationTrigger: TalkSmile
    - playerChoiceText: Doesn't it wear you out?
      npcResponse: "The body tires. The purpose doesn\u2019t. As long as I know why I\u2019m moving, the moving is easy."
      animationTrigger: TalkIdle
  - type: 0
    npcLine: I live with the seminary brothers. Three of us now. We eat together, pray together, check on the parish families on a rotation.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: "Every person I pass through this checkpoint, I pray for tonight. I want you to know that. Even the ones I don\u2019t know yet."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: "I keep my papers in the inside pocket of this coat. Right next to a letter from one of my parishioners. Good placement, I think."
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "She wanted to thank me for a conversation we had three months ago. She said it helped her sleep."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: What did you say to her?
      npcResponse: "That grief and fear sound very different from the outside. From the inside they feel the same. She needed to hear she wasn\u2019t doing it wrong."
      animationTrigger: TalkLookDown
    - playerChoiceText: You seem very peaceful for the circumstances.
      npcResponse: "Peace has to be chosen each morning. Today it was an easier choice than yesterday."
      animationTrigger: TalkSmile
  - type: 0
    npcLine: Here are my papers. Permit runs to December. Everything in order, as always.
    animationTrigger: TalkPoint
    cameraTrigger: 
    wobbleText: 0
    choices: []
