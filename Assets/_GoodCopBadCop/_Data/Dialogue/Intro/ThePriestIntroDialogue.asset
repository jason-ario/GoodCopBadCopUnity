  nodes:
  - type: 0
    npcLine: Hello, brother! It's a bit of a grim morning, but we're still here,
      aren't we?
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: Here are my papers. I've been out since dawn helping with the water
      lines.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: You look tired, officer. Remember to breathe; the air is heavy, but
      the spirit is light.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices: []
