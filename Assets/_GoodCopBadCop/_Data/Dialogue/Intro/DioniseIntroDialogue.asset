--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: DioniseIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Dionise Chkonia, professor of philosophy. Back from the archive again.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: The librarian lets me take whatever books are worth saving.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Taking State property?
      npcResponse: Plato, Rustaveli, two banned Russians. Confiscate them if it makes you feel useful.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Saving them from what?
      npcResponse: The dust gets into the pages. Soon there'll be no one left to read them.
      npcFollowUp: 
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 1
    npcLine: I still lecture on schedule. Half the hall is empty now.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Where did your students go?
      npcResponse: Some left. Some cough at home, and the rest pretend nothing is wrong.
      npcFollowUp: 
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: Any of them from the east?
      npcResponse: Three. They stopped coming after the blast, and I stopped asking.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 0
    npcLine: Routine reassures, Officer. Even yours. Especially yours.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
