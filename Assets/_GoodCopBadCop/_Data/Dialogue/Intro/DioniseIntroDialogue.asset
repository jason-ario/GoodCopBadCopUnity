%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: DioniseIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Good. An officer who pays attention. Dionise Chkonia, professor of philosophy.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: From the archive. Texts worth saving before the dust gets in.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What kind of texts?
      npcResponse: First editions found nowhere else. I won't let another disappear.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Is the dust getting worse?
      npcResponse: Yes. The radio says otherwise. I stopped waiting for the full picture.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 1
    npcLine: I still lecture on schedule. Half the hall is empty.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: How are your children?
      npcResponse: Children adapt. What frightens them is watching us pretend otherwise.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: You seem very calm.
      npcResponse: Stoicism. The only rational response to what you can't control.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 0
    npcLine: Routine reassures. Even here.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
