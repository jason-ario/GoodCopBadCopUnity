%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: DioniseIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: "New here? Good \u2014 I prefer an officer who pays attention. Dionise Chkonia, professor of philosophy."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: "I've taught ethics since things escalated. I'm from the archive today \u2014 texts worth saving before the dust worsens."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What kind of texts?
      npcResponse: Primary sources, first editions found nowhere else. I won't let another disappear.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Is the dust getting worse?
      npcResponse: Yes. We're not getting the full picture, and I stopped waiting for one.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 0
    npcLine: "My students are anxious. People look for structure when the world destabilizes. I keep lectures on schedule \u2014 routine reassures."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I have a wife and two children at home. We're managing. My papers are current, checked every two weeks.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: How are your children holding up?
      npcResponse: Children adapt. What frightens them is watching us pretend otherwise.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: You seem very calm about all of this.
      npcResponse: Stoicism. It's the only rational response to what you can't control.
      animationTrigger: TalkIdle
      playLaughSfx: 0
