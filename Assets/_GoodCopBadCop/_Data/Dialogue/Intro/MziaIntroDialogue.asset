%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: MziaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Hello, dear. Papers under my Bible. Mzia Kakulia, southern block.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: I mend from home with my granddaughter. Mending matters more than new, these days.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Is she a seamstress too?
      npcResponse: A nurse. Her hands shake. I don't say anything.
      npcFollowUp: 
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: What's in the basket?
      npcResponse: Red yarn, for my grandson's sweater. He went east, and he'll be cold.
      npcFollowUp: 
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 1
    npcLine: You look thin, dear. Are they feeding you on those coupons?
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Just answer the questions.
      npcResponse: Mm. Stern. The last boy was stern too, at first.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Don't worry about me.
      npcResponse: I'll worry anyway. Two husbands taught me it keeps the hands busy.
      npcFollowUp: 
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 0
    npcLine: I always make too much soup. Come by later.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
