%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: MziaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Hello, dear. Papers kept under my Bible. Mzia Kakulia, southern block.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I mend from home. Mending matters more than new, these days.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What do people bring?
      npcResponse: Coats. Socks. You wouldn't believe how many forget spare socks.
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: Do you work alone?
      npcResponse: Irina helps, when her hands aren't shaking. I don't say anything.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 1
    npcLine: You look thin, dear. Are they feeding you on those coupons?
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: I'm fine, thank you.
      npcResponse: Mm. I'll worry anyway. Keeps my hands busy.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: That's kind of you.
      npcResponse: Kindness is cheaper than medicine, dear. Two husbands taught me.
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 0
    npcLine: I always make too much soup. Come by later.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
