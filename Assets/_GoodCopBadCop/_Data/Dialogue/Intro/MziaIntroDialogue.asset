  nodes:
  - type: 0
    npcLine: Hello, dear. You look thin; are they feeding you enough at this booth?
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: Here are my papers. I kept them under my Bible so they wouldn't wrinkle.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: It's a bit chilly today. I hope you're wearing your thermal vest under
      that uniform.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices: []
