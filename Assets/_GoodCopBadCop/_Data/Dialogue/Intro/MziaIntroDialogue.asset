%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: MziaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Hello, dear, papers kept under my Bible. Mzia Kakulia. Southern block, fourth floor, thirty-one years there.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I work as a seamstress, from home. People bring me things to mend. Mending matters more than new, these days.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What do people bring you?
      npcResponse: Coats, mostly, and socks. You wouldn't believe how many forget spare socks.
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: Do you work alone?
      npcResponse: My granddaughter Irina lives with me now. She helps when her hands aren't shaking. I don't say anything.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 0
    npcLine: My husband helps at the bakery weekends. I'm going home to finish a sweater for my grandson. You look thin, dear, are they feeding you?
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I have soup at home if you want it later, I always make too much. Permit's here, November expiry.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: That's very kind of you.
      npcResponse: I've outlived two husbands and one very bad winter. Kindness is cheaper than medicine.
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: You don't need to worry about me.
      npcResponse: Mm, I'll worry anyway. Keeps my hands busy.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
