%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: MziaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: "Hello, dear. Here are my papers. I kept them under my Bible so they
      wouldn\u2019t wrinkle. Mzia Kakulia. I live in the southern block, fourth
      floor. I have lived there for thirty-one years."
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "I work as a seamstress, from home mostly. People still bring me things to mend. In times like these, mending is more important than new."
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: What do people bring you?
      npcResponse: Coats, mostly. And socks. You would not believe how many people forget to bring spare socks when things go wrong.
      animationTrigger: TalkSmile
    - playerChoiceText: Do you work alone?
      npcResponse: "My granddaughter Irina lives with me now. She helps when her hands aren\u2019t shaking. Which they do, lately. I don\u2019t say anything."
      animationTrigger: TalkLookDown
  - type: 0
    npcLine: "My husband helps at the bakery on weekends, a good man, very steady.
      I\u2019m going home to finish a sweater \u2014 a very bright red. My grandson
      would love it. You look thin, dear. Are they feeding you enough at this post?"
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "I have a pot of soup at home if you want it later. I always make too
      much. Permit is here. November expiry. Everything in order."
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: That's very kind of you.
      npcResponse: "I have outlived two husbands and one very bad winter. Kindness is cheaper than medicine and it lasts longer."
      animationTrigger: TalkSmile
    - playerChoiceText: You don't need to worry about me.
      npcResponse: "Mm. I will worry anyway. It keeps my hands busy when the knitting runs out."
      animationTrigger: TalkLookAway
