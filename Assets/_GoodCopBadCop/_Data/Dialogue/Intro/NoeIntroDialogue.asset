%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: NoeIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: Here. ID, form. Filled it out while waiting in the bread line. Noe
      Barbaqadze. I run the corner grocery on the eastern block. Or I did.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: The shop's still open. I go every morning. Open the door, check the
      empty shelves, stand there a while. Then close.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: Why keep it open?
      npcResponse: Force of habit, I think. The routine feels more normal than
        the alternative.
      animationTrigger: TalkIdle
    - playerChoiceText: That sounds bleak.
      npcResponse: Does it? I've been standing in lines my whole life. First for
        bread, then for permits. This is just a new kind of line.
      animationTrigger: TalkLookAway
  - type: 0
    npcLine: I live alone. The apartment's quiet. My neighbor stopped answering
      his door two weeks ago. I haven't knocked since. I'm fine. I say that to
      everyone.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: I have nowhere urgent to be. Same as yesterday. Permit, September
      expiry, I think. The dates have started to blur.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: Does the wait bother you?
      npcResponse: No. I have nowhere urgent to be on the other side either.
      animationTrigger: TalkLookAway
    - playerChoiceText: Have you always lived here?
      npcResponse: My whole life. Same street, same district. I thought about
        leaving once. The line for the exit was too long.
      animationTrigger: TalkIdle
