  nodes:
  - type: 0
    npcLine: Here's my ID and the form. I filled them out while waiting for bread.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I'm just going home. The shop ran out of everything by noon anyway.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: Is your stamp working? Everything else in this city seems to be broken.
    animationTrigger: TalkIdle
