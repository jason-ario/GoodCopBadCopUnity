--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: NoeIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: ID and form, filled in the bread line. Noe Barbaqadze, corner grocery.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: I open the shop each morning, look at the empty shelves, and close.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Why keep opening?
      npcResponse: Habit. Routine feels more normal than the alternative.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Any deliveries?
      npcResponse: Last truck came before the blast. I'm still selling its matches.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 1
    npcLine: My neighbor [[whisper:stopped answering his door]]. I saw him in the bread line yesterday.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Did you speak to him?
      npcResponse: He looked at me like we'd never met. Six years on the same landing.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Why not report it?
      npcResponse: Report what? A man who doesn't answer? Half the block doesn't.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: I thought about leaving once. The exit line was too long.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
