%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: NoeIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: ID and form, filled in the bread line. Noe Barbaqadze, corner grocery.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I open the shop every morning. Check the empty shelves. Stand a while. Close.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Why keep opening?
      npcResponse: Habit. Routine feels more normal than the alternative.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Any deliveries?
      npcResponse: Last truck came before the blast. I'm still selling its matches.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 1
    npcLine: Quiet apartment. My neighbor [[whisper:stopped answering his door]]. I haven't knocked since.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Why not knock?
      npcResponse: If he answers, I have to see him. I'm fine.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Doesn't the wait bother you?
      npcResponse: No. Bread, then permits. I've stood in lines my whole life.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: I thought about leaving once. The exit line was too long.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
