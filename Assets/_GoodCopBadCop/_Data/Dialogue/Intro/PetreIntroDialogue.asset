%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: PetreIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: You're new here, or I'm late. Petre Dolidze. I keep a small parish above the north ridge.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I write, when there's nothing else to do. The poems go nowhere. I consider that a feature.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Have you published them?
      npcResponse: Two volumes. One printed, one in a manuscript I lent out and never got back.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: What do you write about?
      npcResponse: God. Mountains. The dog. In varying order depending on the week.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: I have a dog, large grey thing, walks the ridge with me. I had a wife once, she found the mountain too quiet.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: The quiet doesn't bother me, I think that was the problem. My papers. The dog doesn't have documents, but I vouch for him.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: How long have you been at the parish?
      npcResponse: Twelve years, came up after the seminary. Thought it'd be temporary. It suits me.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: What brought you down tonight?
      npcResponse: I needed to see something with more than two walls.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
