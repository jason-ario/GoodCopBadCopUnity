%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: PetreIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: You're new, or I'm late. Petre Dolidze. Small parish above the north ridge.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: I write poems. They go nowhere. I consider that a feature.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Why come down from the ridge?
      npcResponse: Candles and flour. And I needed something with more than two walls.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Who reads them?
      npcResponse: God, I hope. The dog listens. Nobody else has asked.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: A gray dog walks the ridge with me. Lately he won't come inside.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Is the dog sick?
      npcResponse: He stopped eating. He stands at the tree line and stares north.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Anyone else up there?
      npcResponse: My wife, once. She found the quiet too loud. I didn't.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: Papers. The dog has none, but I vouch for him.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
