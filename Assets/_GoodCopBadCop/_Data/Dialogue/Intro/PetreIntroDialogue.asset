%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: PetreIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: You're new, or I'm late. Petre Dolidze. Small parish above the north ridge.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I write poems. They go nowhere. I consider that a feature.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What do you write about?
      npcResponse: God. Mountains. The dog. Order depends on the week.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Published anything?
      npcResponse: Two volumes. One printed, one lent out and never returned.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: A grey dog walks the ridge with me. My wife found it too quiet.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: And you?
      npcResponse: The quiet doesn't bother me. I think that was the problem.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Why come down tonight?
      npcResponse: I needed something with more than two walls.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: Papers. The dog has none, but I vouch for him.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
