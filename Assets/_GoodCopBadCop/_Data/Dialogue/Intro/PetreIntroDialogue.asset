%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: PetreIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: You're new here. Or I'm late.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: Petre Dolidze. I keep a small parish above the north ridge. I come down
      when I need to.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: I write, when there's nothing else to do. Which is most of the time. The
      poems go nowhere. I consider that a feature.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: Have you published them?
      npcResponse: Two volumes. One printed, one in a manuscript I lent out and never
        got back. I've made peace with it.
      animationTrigger: TalkIdle
    - playerChoiceText: What do you write about?
      npcResponse: God. Mountains. The dog. In varying order depending on the week.
      animationTrigger: TalkLookAway
  - type: 0
    npcLine: I have a dog. Large grey thing. He walks the ridge with me. Good company.
      Neither of us talks much.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I don't have a family here. I had a wife for a while. She found the mountain
      too quiet.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: The quiet doesn't bother me. I think that was always the problem.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: How long have you been at the parish?
      npcResponse: Twelve years. I came up after the seminary. Thought it would be
        temporary. It suits me.
      animationTrigger: TalkIdle
    - playerChoiceText: What brought you down tonight?
      npcResponse: I needed to see something with more than two walls. The ridge has
        been very present lately.
      animationTrigger: TalkLookAway
  - type: 0
    npcLine: My papers. The dog doesn't have documents but I can vouch for him.
    animationTrigger: TalkPoint
    cameraTrigger: 
    wobbleText: 0
    choices: []
