%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: KseniaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: Hello. I have the form, my mom helped fill it out. Ksenia Darnik.
      I'm eleven. I go to the school on Lenina Street.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: School's very loud lately. A lot of empty desks. I like the quiet
      days best, the ones where hardly anyone shows up.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: What do you do there?
      npcResponse: Lessons, mostly. And I look after the little ones at recess.
        That part I'm good at.
      animationTrigger: TalkIdle
    - playerChoiceText: Do you live nearby?
      npcResponse: Near enough. Just me and my mom. She's kind.
      animationTrigger: TalkLookAway
  - type: 0
    npcLine: The building across from my school has a crack in the wall. It's
      been getting wider. I've been watching it. I found a shiny stone on the
      way here. I don't know why I picked it up.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: Sometimes I think if I hold very still, the loud parts will just
      go past me. My papers are in order. I checked three times.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: Are you alright?
      npcResponse: I think so. I've just been playing pretend a lot lately. It
        helps.
      animationTrigger: TalkLookDown
    - playerChoiceText: You can ignore the noise.
      npcResponse: I try. It's harder at night. During the day there's more to
        look at.
      animationTrigger: TalkLookAway
