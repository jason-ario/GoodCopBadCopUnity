  nodes:
  - type: 0
    npcLine: Hello. My mom said I have to show you this paper.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: It's very loud out there. Is it always going to be this loud?
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I found a shiny stone in the dirt. Do you want to see?
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
