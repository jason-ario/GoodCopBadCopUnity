%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: KseniaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Hello. Mom helped with the form. Ksenia Darnik. I'm eleven.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: School on Lenina Street is quiet now. Lots of empty desks.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Where did everyone go?
      npcResponse: Away. Or sick. I like the quiet days best.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Who's at home?
      npcResponse: Just me and my mom. She's kind.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: I found a shiny stone on the way here. I don't know why I picked it up.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Can I see it?
      npcResponse: No. It's warm. It likes my pocket.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: Are you alright?
      npcResponse: I think so. When I hold very still, the loud parts go past me.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: I checked my papers three times. ...You blink a lot.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
