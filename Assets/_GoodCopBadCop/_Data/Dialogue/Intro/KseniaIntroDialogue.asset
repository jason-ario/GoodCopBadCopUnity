%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: KseniaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: "Hello. I have the form. I filled it out this morning."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: "Ksenia Darnik. I work at the district hospital. Children\u2019s ward, mostly."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "The hospital is very loud lately. A lot of families. I prefer the quiet shifts. The night ones, when the kids are asleep."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: What do you do there?
      npcResponse: "I check temperatures. I hold hands when they\u2019re scared. That part I\u2019m good at."
      animationTrigger: TalkIdle
    - playerChoiceText: Do you live nearby?
      npcResponse: "Near enough. Two other nurses share the flat with me. They\u2019re kind."
      animationTrigger: TalkLookAway
  - type: 0
    npcLine: The building across from the hospital has a crack in the east wall. It has been getting wider. I have been watching it.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I found a shiny stone on the way here today. I don't know why I picked it up. It just seemed important.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: "It\u2019s very loud out there. The street. It keeps getting louder and I don\u2019t know how to make it smaller."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: Sometimes I think if I hold very still, the loud parts will just go past me.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: Are you alright?
      npcResponse: "I think so. I\u2019ve been feeling a bit... young lately. I know that sounds strange."
      animationTrigger: TalkLookDown
    - playerChoiceText: You can ignore the noise.
      npcResponse: "I try. It\u2019s harder at night. During the day there\u2019s more to look at."
      animationTrigger: TalkLookAway
  - type: 0
    npcLine: My papers. They're in order. I checked three times.
    animationTrigger: TalkPoint
    cameraTrigger: 
    wobbleText: 0
    choices: []
