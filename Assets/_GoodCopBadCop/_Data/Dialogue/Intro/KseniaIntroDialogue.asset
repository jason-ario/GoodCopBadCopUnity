%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: KseniaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: Hello. I have the form, my mom helped fill it out. Ksenia Darnik, I'm eleven. I go to school on Lenina Street.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: School's loud lately, lots of empty desks. I like the quiet days best, when hardly anyone shows up.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What do you do there?
      npcResponse: "Lessons, mostly. I look after the little ones at recess \u2014 I'm good at that."
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Do you live nearby?
      npcResponse: Near enough. Just me and my mom. She's kind.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: The building across from my school has a crack that's getting wider. I found a shiny stone on the way here. I don't know why I picked it up.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Sometimes if I hold very still, the loud parts go past me. My papers are in order, I checked three times.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Are you alright?
      npcResponse: I think so. I've just been playing pretend a lot lately. It helps.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: You can ignore the noise.
      npcResponse: I try. It's harder at night. During the day there's more to look at.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
