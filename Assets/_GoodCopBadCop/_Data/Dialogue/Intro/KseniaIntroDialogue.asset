%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: KseniaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: "Hello. I have the form. My mom helped me fill it out this morning."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: "Ksenia Darnik. I\u2019m eleven. I go to the school on Lenina Street."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "School is very loud lately. A lot of empty desks. I like the quiet days best. The ones where hardly anyone shows up."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: What do you do there?
      npcResponse: "Lessons, mostly. And I look after the little ones at recess. That part I\u2019m good at."
      animationTrigger: TalkIdle
    - playerChoiceText: Do you live nearby?
      npcResponse: "Near enough. Just me and my mom. She\u2019s kind."
      animationTrigger: TalkLookAway
  - type: 0
    npcLine: The building across from my school has a crack in the wall. It has been getting wider. I have been watching it.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I found a shiny stone on the way here today. I don't know why I picked it up. It just seemed important.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: "It\u2019s very loud out there. The street. It keeps getting louder and I don\u2019t know how to make it smaller."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: Sometimes I think if I hold very still, the loud parts will just go past me.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: Are you alright?
      npcResponse: "I think so. I\u2019ve just been playing pretend a lot lately. It helps."
      animationTrigger: TalkLookDown
    - playerChoiceText: You can ignore the noise.
      npcResponse: "I try. It\u2019s harder at night. During the day there\u2019s more to look at."
      animationTrigger: TalkLookAway
  - type: 0
    npcLine: My papers. They're in order. I checked three times.
    animationTrigger: TalkPoint
    cameraTrigger: 
    wobbleText: 0
    choices: []
