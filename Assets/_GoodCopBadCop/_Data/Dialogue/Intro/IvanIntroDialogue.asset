%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: IvanIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: What a beautiful morning! Ivan Tarkov, factory worker, east side.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I keep a list of every officer I meet. You're number nine!
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What kind of list?
      npcResponse: Names, faces, shifts. Very thorough.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: That's an odd hobby.
      npcResponse: I have many! Collecting, counting, arranging. You have lovely cheekbones.
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 1
    npcLine: The alleys by the factory are so quiet since curfew.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: With that bag?
      npcResponse: Oh, always the bag! You never know what you'll find.
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: Alone, after curfew?
      npcResponse: I'm never alone! I'm very good company.
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 0
    npcLine: Papers! All in order. I'll see you soon.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
