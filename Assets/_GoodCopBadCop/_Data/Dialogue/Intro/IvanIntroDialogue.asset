%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: IvanIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: What a beautiful morning! Papers, right here. Ivan Tarkov, factory worker, east side. Very productive place.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I like meeting new faces here. I keep a list of every officer I meet.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: That's an unusual hobby.
      npcResponse: I have many hobbies! Collecting, counting, arranging things very neatly. You have lovely cheekbones.
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: What kind of list?
      npcResponse: Names, faces, schedules. Very thorough. My mother said I pay too much attention to detail.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 0
    npcLine: I live alone. More room for my hobbies. I always smile. The alleyways near the factory are peaceful lately.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I go walking there in the evenings, sometimes with a bag. Papers, everything's in order.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: I wouldn't walk there alone.
      npcResponse: Oh, I never feel alone! I'm very good company. Very aware of my surroundings.
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: What do you walk for?
      npcResponse: Fresh air! Reflection! Sometimes just to hear what the quiet sounds like.
      animationTrigger: TalkIdle
      playLaughSfx: 0
