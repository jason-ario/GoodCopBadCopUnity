%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: IvanIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: What a beautiful morning! Ivan Tarkov, factory worker, east side.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: I keep a list of every officer I meet. You're number nine!
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: What happened to number eight?
      npcResponse: Oh, he stopped showing up. They do that! I still have his page.
      npcFollowUp: 
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: Why keep a list?
      npcResponse: Names, faces, shifts. I like to know who's watching the gate.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: I take my bag for walks by the factory. So quiet since curfew!
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: What's in the bag?
      npcResponse: Oh, just my things! You never know what you'll find out there.
      npcFollowUp: 
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: Why out after curfew?
      npcResponse: Somebody has to be! The alleys get lonely. I'm very good company.
      npcFollowUp: 
      animationTrigger: TalkSmile
      playLaughSfx: 0
  - type: 0
    npcLine: Papers, all in order! I'll see you soon. Very soon.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
