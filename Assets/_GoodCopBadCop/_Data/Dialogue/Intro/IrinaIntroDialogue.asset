  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: IrinaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: Here are my papers. Sorry, I know I look tired. The energy in the ward
      has been really heavy lately.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: The universe keeps asking us to carry more than we think we can. I'm
      learning to hold.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: Good morning. I keep my documents in my grandmother's prayer book. For
      protection.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
