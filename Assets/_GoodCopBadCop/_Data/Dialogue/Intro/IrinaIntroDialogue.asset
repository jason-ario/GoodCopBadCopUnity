%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: IrinaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Sorry, I look tired. Irina Kakulia, student nurse at the care home.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: I live with my grandmother now. Mzia, the seamstress, southern block.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Why move in with her?
      npcResponse: My brother went east for work. Someone had to stay with her.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Is she sick?
      npcResponse: Old, not sick. She says she's fine, the way she says her stitches are straight.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 1
    npcLine: My [[infected:hands shake a little]]. The air, I think. Or bad energy on the ward.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: Hold your hands still.
      npcResponse: I'm trying. ...There. It passes if I breathe through it.
      npcFollowUp: 
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: What are you taking?
      npcResponse: Something from the ward cabinet, to sleep. Nobody counts the bottles anymore.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: Breathe, Officer. You're holding it in.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
