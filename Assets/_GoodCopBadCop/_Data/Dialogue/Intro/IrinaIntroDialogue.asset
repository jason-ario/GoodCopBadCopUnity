%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: IrinaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: "Sorry, I look tired \u2014 ward energy's been heavy. Irina Kakulia, student nurse. I cover elder care and my grandmother at home."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: "I moved in with her a few months ago \u2014 fourth floor, southern block. Mzia, the seamstress. You may have seen her."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Is she doing well?
      npcResponse: "She keeps telling me she's fine \u2014 the same way she talks about her sewing. So I mostly believe her."
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: That must be a lot to balance.
      npcResponse: The universe keeps asking us to carry more than we think. I'm still surprised how much I hold.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: "My rotation is four mornings a week. I keep her medication schedule with mine. My hands shake a little \u2014 the air, I think. Or mercury retrograde."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: "The patients ask what's happening; I tell them to breathe through it. My papers are organized \u2014 the one thing I can keep that way."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Is that working?
      npcResponse: For some of them. For me, I'm still deciding.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: How are you holding up?
      npcResponse: I'm aligned, mostly. The frequency in the ward is strange right now.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
