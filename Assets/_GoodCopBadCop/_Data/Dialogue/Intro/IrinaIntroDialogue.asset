%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: IrinaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Sorry, I look tired. Irina Kakulia, student nurse. The ward energy's heavy.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I live with my grandmother now. Mzia, the seamstress, southern block.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Is she doing well?
      npcResponse: She says she's fine, the way she talks about her sewing. I mostly believe her.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Isn't that a lot?
      npcResponse: The universe keeps handing us more than we think we can hold.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 1
    npcLine: My [[infected:hands shake a little]]. The air, I think. Or mercury retrograde.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What's wrong with the air?
      npcResponse: Ask the polyclinic. They say smog. They also say stay calm and queue.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: How are your patients?
      npcResponse: They ask what's happening. I tell them to breathe through it.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: Breathe, officer. You're holding it in.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
