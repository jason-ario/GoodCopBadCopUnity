%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: JanaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: My documents, I had them ready. Jana Sokolova, second residential row.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: You noticed the dress. It's for a ceremony later.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What ceremony?
      npcResponse: A wedding. The date keeps moving. [[whisper:I don't remember]] when it started.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: How long have you worn it?
      npcResponse: It holds its shape. The seamstress on my floor mends it.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: I sell flowers on the residential row. Funerals, mostly, lately.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Who's buying flowers now?
      npcResponse: Widows. They pay in ration coupons. I take them.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Who waits at home?
      npcResponse: He does. He gets home later now. I wait. I'm good at that.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 0
    npcLine: I know this part. It's the parts in between I lose.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
