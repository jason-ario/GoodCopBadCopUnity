%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: JanaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: "Here. My documents. I had them ready. Jana Sokolova. I live in the
      residential block at the end of the second row. I have been there for four
      years."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "The dress. I can see you noticed. It\u2019s for a ceremony. Later. The timing has been complicated."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: What kind of ceremony?
      npcResponse: "A wedding. The date has moved several times. There was a delay. I don\u2019t remember exactly when it started."
      animationTrigger: TalkLookAway
    - playerChoiceText: How long have you been wearing it?
      npcResponse: "It holds its shape well. I\u2019ve had it mended in a few places. The seamstress on my floor is very kind."
      animationTrigger: TalkIdle
  - type: 0
    npcLine: "I work at the flower stall on the residential row \u2014 arrangements
      for whatever occasion people need. Funerals mostly, lately. I come through
      this checkpoint every day. I know the process. I answer the questions in order."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "I have a very good memory for procedures. Other things I lose sometimes.
      Not the procedures. My permit. June expiry. I filed it myself. Everything
      is in order."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: You seem very familiar with the routine.
      npcResponse: I have been through it many times. The routine is easier than the parts in between.
      animationTrigger: TalkLookAway
    - playerChoiceText: Do you have someone waiting at home?
      npcResponse: "Yes. Soon. He gets home later now. But I wait. I\u2019m very good at waiting."
      animationTrigger: TalkIdle
