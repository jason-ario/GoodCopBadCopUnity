%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: JanaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: My documents, ready. Jana Sokolova, flower stall, residential row.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
  - type: 1
    npcLine: You're looking at the dress. It's for a ceremony later.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: What ceremony?
      npcResponse: A wedding. The date keeps moving. [[whisper:I don't remember]] when it started.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Who's the groom?
      npcResponse: He works late now, later every week. I'm good at waiting.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: I sell flowers on the row. Funerals, mostly, lately.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices:
    - playerChoiceText: How many funerals?
      npcResponse: Six this week. The lilies run out first.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Did you know any of them?
      npcResponse: One. I made her bouquet years ago. Or it might have been mine.
      npcFollowUp: 
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 0
    npcLine: I know this part. It's the parts in between I lose.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    unskippable: 0
    choices: []
