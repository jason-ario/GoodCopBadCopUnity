  nodes:
  - type: 0
    npcLine: Here. My documents. Could we be quick? I have somewhere to be.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: Good morning. I keep my papers in the flowers. I forgot, I do not have
      flowers today.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I am a resident. I have been a resident for four years. The dress is
      for later.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
