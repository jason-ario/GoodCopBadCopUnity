%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: JanaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Here, my documents, I had them ready. Jana Sokolova. Residential block, end of the second row. Four years now.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: "The dress \u2014 I see you noticed. It's for a ceremony later. The timing's been complicated."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What kind of ceremony?
      npcResponse: A wedding. The date's moved several times. I don't remember when it started.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: How long have you been wearing it?
      npcResponse: It holds its shape well. Mended in a few places by the seamstress on my floor, who's very kind.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 0
    npcLine: "I work the flower stall on the residential row, funerals mostly lately. I come through here every day \u2014 I know the process."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: "I have a good memory for procedures \u2014 other things I lose sometimes. My permit's here, June expiry."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: You seem very familiar with the routine.
      npcResponse: I've been through it many times. The routine's easier than the parts in between.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Do you have someone waiting at home?
      npcResponse: Yes, soon. He gets home later now, but I wait. I'm good at that.
      animationTrigger: TalkIdle
      playLaughSfx: 0
