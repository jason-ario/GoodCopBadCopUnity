%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: EmzarIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: Hello. ...You are new.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I keep track of faces. The last officer had different eyes. Yours are
      better. ...That is not a threat.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: Emzar Jalaghonia. Beekeeper's assistant, east side. The master runs
      the hives. I do what needs doing.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: What does that involve?
      npcResponse: Cleaning frames. Moving boxes. Standing near the hives until they
        adjust to you. Some people never learn to be still.
      animationTrigger: TalkLookAway
    - playerChoiceText: Who is the master?
      npcResponse: He does not use his name. He says names make people complicated.
        ...I have stopped asking.
      animationTrigger: TalkLookAway
  - type: 0
    npcLine: The bees were quiet today. That is... a good day.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I have been listening to them for two years. I am starting to understand
      what they are saying.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I rent rooms with a work crew. Louder than I prefer. But they do not
      ask questions. ...Fair.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: My chest has been tight lately. From the dust at the site, the foreman
      says.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: You do construction too?
      npcResponse: The apiary does not pay every week. The site does. The master
        says I am useful. The foreman says I am quiet.
      animationTrigger: TalkIdle
    - playerChoiceText: You should see a doctor.
      npcResponse: ...Yes. Probably. The lines are very long. The master says urgency
        is what gets people stung. I think he means more than bees.
      animationTrigger: TalkLookDown
  - type: 0
    npcLine: My papers. The master reminded me this morning. He says careful people
      last. ...More than bees.
    animationTrigger: TalkPoint
    cameraTrigger: 
    wobbleText: 0
    choices: []
