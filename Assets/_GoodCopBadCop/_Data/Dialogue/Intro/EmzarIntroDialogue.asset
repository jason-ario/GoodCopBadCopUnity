MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: EmzarIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Hello. ...You are new. I keep track of faces.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Emzar Jalaghonia. Beekeeper's assistant, east side. The master runs the hives.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Who is the master?
      npcResponse: He does not use his name. Says names make people complicated.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: What do you do?
      npcResponse: Clean frames. Stand near the hives until they adjust. ...They adjust.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 1
    npcLine: My [[infected:chest's been tight]]. The dust, the foreman says. ...I also do construction.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Have you seen a doctor?
      npcResponse: ...The lines at the polyclinic are long. The master says urgency gets people stung.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: How are the bees?
      npcResponse: Quiet. Since the blast they stay inside. ...Good day.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: ...Papers. Here.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
