%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: EmzarIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: Hello. ...You are new. I keep track of faces. Yours are better than the last officer's. ...Not a threat.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Emzar Jalaghonia. Beekeeper's assistant, east side. The master runs the hives; I help.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What does that involve?
      npcResponse: Cleaning frames, moving boxes, standing near hives until they adjust.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Who is the master?
      npcResponse: He does not use his name. Says names make people complicated. ...I stopped asking.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: "The bees were quiet today \u2014 good day. I rent with a work crew, louder than I like, but they don't ask questions. ...Fair."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: "My chest's been tight lately \u2014 dust at the site, the foreman says. My papers are here."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: You do construction too?
      npcResponse: The apiary doesn't pay every week. The site does. The master says I'm useful.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: You should see a doctor.
      npcResponse: ...Yes, probably. The lines are long. The master says urgency is what gets people stung.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
