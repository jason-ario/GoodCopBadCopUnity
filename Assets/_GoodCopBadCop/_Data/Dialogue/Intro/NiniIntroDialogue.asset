%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: NiniIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: "The shadow your booth makes at this hour \u2014 have you noticed how
      it falls? I\u2019ve been meaning to sketch it. Nini Bitsadze. I have a studio
      on the third floor above the tailor\u2019s. I paint. Or I paint what\u2019s
      left to paint."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "I\u2019ve been working on a series about the change in light. Before the dust, after the dust. The difference is extraordinary. Terrible, but extraordinary."
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: What does the light look like now?
      npcResponse: "Like the world is being lit from below instead of above. Everything has an amber cast. The shadows are wrong. I cannot stop painting it."
      animationTrigger: TalkLookAway
    - playerChoiceText: Is it hard to paint during all this?
      npcResponse: "Hard? The opposite. Everything is strange and stark and honest. The hardest part is knowing it won\u2019t last much longer."
      animationTrigger: TalkIdle
  - type: 0
    npcLine: "I have a condition. It\u2019s managed. I pick up my prescription on
      the way here sometimes, less often lately. I have a caretaker, Tamar \u2014
      she comes in the mornings, makes sure I\u2019ve eaten. The charcoal on my
      hands is always going to be there."
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: "My documents are usually inside my sketchbook. I keep them separate
      from the charcoal pages. Mostly separate. Papers. December expiry. The smudge
      on the corner is just pigment. It won\u2019t transfer."
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: The charcoal is fine.
      npcResponse: "Good. The last officer asked me about it every time. I started counting. Eleven mentions. I have it in my notebook."
      animationTrigger: TalkLookAway
    - playerChoiceText: You have a good face for charcoal.
      npcResponse: "Strong lines. Yes. I noticed. I\u2019ve been thinking about it since you sat down."
      animationTrigger: TalkLookAway
