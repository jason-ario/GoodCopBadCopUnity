  nodes:
  - type: 0
    npcLine: Hello. My documents are right here. I hope the charcoal smudges don't
      bother you.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: The way the shadows fall across your booth today is quite striking.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: I'm just heading back to my studio. The morning light was perfect for
      sketching.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
