%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: NiniIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Have you noticed the shadow your booth makes? Nini Bitsadze. I paint.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I'm painting the light since the dust. The difference is extraordinary.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What does it look like?
      npcResponse: Like the world's lit from below. Everything has an amber cast.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Hard to paint now?
      npcResponse: The opposite. Everything's strange and honest. It won't last.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: The [[infected:charcoal on my hands]] never comes off. Tamar checks on me mornings.
    animationTrigger: TalkLookDown
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Who's Tamar?
      npcResponse: My caretaker. I have a condition. It's managed.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: The charcoal's fine.
      npcResponse: Good. The last officer asked every time. I started counting.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: You have a good face for charcoal. I've been sketching it since you sat down.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
