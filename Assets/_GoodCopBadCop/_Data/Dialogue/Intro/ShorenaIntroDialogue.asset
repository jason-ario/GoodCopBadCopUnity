%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: ShorenaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: New form. The spacing changed. Shorena Maisuradze, schoolteacher, twenty-two years.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: My daughters are waiting on the fourth floor. I said I'd be [[whisper:back before dark]].
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: How old are they?
      npcResponse: Tamara's twelve, argues everything. Nana's nine, accepts too much.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Are they alright?
      npcResponse: They're afraid and hiding it. I pretend not to notice.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 1
    npcLine: School's closed. My students are scattered over four shelters. I still send work.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Does anyone do it?
      npcResponse: One of three, last week. One is enough to keep going.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Is that a priority now?
      npcResponse: Children fall apart without structure. Adults too. So, yes.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: Please. Before dark.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
