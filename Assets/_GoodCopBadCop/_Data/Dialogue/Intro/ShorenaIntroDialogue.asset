%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: ShorenaIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: You have a new form. The spacing's different from last week. Shorena Maisuradze, secondary school teacher, twenty-two years.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: My daughters are on the fourth floor waiting for me. I told them I'd be back before dark.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: How old are your daughters?
      npcResponse: Tamara is twelve, Nana is nine. Tamara argues about everything; Nana accepts too much.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Are they doing alright?
      npcResponse: They're afraid. They're trying not to show me. I pretend not to notice.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
  - type: 0
    npcLine: The school is closed now, technically. I still go in to manage the materials.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: My students are scattered across four shelters. I sent work to three last week. Only one submitted it.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: That was kind of you.
      npcResponse: It wasn't kindness, it was structure. Children fall apart without it. Adults too.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Is that really a priority right now?
      npcResponse: Everything I've said for twenty-two years is meaningless if I stop now. So, yes.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
