%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: VladIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: You look nervous, officer. Relax, I'm just a businessman coming home. Vladimir Syrnikov, import and logistics.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I own property in six districts, including this one. You're standing in one of my doorways.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: This is a public checkpoint.
      npcResponse: Everything's someone's property eventually. The city is reorganizing itself. I'm paying attention.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: I don't recognize your name.
      npcResponse: You will. Or someone who answers to me will introduce us. Either way, not a concern.
      animationTrigger: TalkCocky
      playLaughSfx: 0
  - type: 0
    npcLine: I work out of the docks, mostly import. The imports aren't relevant to your paperwork. Shame if something made your job harder.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Here are the papers. Don't smudge the ink, I'm a man who likes things clean. Permit runs to December.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: I'll handle them carefully.
      npcResponse: Good. A man who respects documents respects the transaction. I appreciate that.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: I treat all documents the same.
      npcResponse: Of course. That's what you're supposed to say. We'll see what that costs you eventually.
      animationTrigger: TalkCocky
      playLaughSfx: 0
