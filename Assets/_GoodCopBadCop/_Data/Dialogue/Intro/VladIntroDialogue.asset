%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: VladIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Relax, officer. Just a businessman coming home. Vladimir Syrnikov, import and logistics.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I own property in six districts. You're standing in one of my doorways.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: This is a State checkpoint.
      npcResponse: Everything belongs to someone eventually. I'm paying attention.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Never heard of you.
      npcResponse: You will. Or someone who answers to me will introduce us.
      animationTrigger: TalkCocky
      playLaughSfx: 0
  - type: 1
    npcLine: My imports aren't your paperwork. Shame if something {{made your job harder}}.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Is that a threat?
      npcResponse: It's logistics. Don't smudge the ink. I like things clean.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: I treat everyone the same.
      npcResponse: Of course you do. We'll see what that costs you.
      animationTrigger: TalkCocky
      playLaughSfx: 0
  - type: 0
    npcLine: Respect the papers, officer. Respect the transaction.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
