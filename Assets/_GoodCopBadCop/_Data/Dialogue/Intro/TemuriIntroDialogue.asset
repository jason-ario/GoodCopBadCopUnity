%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: TemuriIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Papers. Temur Gelashvili. Timber, northern forest. Twice a season in the city.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: The birds left the valley this morning. Something's coming from the north.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: How do the birds know?
      npcResponse: Watch anything long enough, it tells you things. Birds know first.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: What's coming?
      npcResponse: The kind that changes the air first. You can't smell it yet.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 1
    npcLine: The trees by the eastern fence are [[infected:turning gray]]. Not from cold.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What's doing it?
      npcResponse: Something leaves marks in the soil no animal makes. I've tracked it a week.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Safe out there alone?
      npcResponse: Safe is a city word. Out there you watch or you don't.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: I watch. Stamp it.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
