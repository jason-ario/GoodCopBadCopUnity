%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: TemuriIntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Papers. Timber route. Temur Gelashvili. I work the northern forest. I come into the city twice a season.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: The birds left the valley this morning, early. That means something's coming from the north.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: How do you know from the birds?
      npcResponse: You watch something long enough, it tells you things. Birds always know before we do.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: What kind of bad?
      npcResponse: The kind that changes the smell of the air first. You can't smell it yet.
      animationTrigger: TalkIdle
      playLaughSfx: 0
  - type: 0
    npcLine: I live alone, cabin past the north gate. The trees near the eastern fence are turning gray, not from cold.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I've been tracking them for a week. They leave marks in the soil no animal makes. Permit's here, November.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What kind of things?
      npcResponse: I don't have a name for them. I've tracked for thirty years. These are new.
      animationTrigger: TalkIdle
      playLaughSfx: 0
    - playerChoiceText: Is it safe for you out there alone?
      npcResponse: Safe is a city word. Out there you're either watching or you're not. I watch.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
