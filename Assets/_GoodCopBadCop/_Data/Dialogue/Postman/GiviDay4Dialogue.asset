%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: GiviDay4Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 0
  nodes:
  - type: 0
    npcLine: The last dispatch, Officer. The satchel feels heavier than it should.
    animationTrigger: FakeCough
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Everything's green at the edges. The fog tells me to pull the wires down.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Don't listen to it.
      npcResponse: It speaks in my voice now. I can't tell which of us is talking.
      npcFollowUp: 
      animationTrigger: Talk1
      playLaughSfx: 0
    - playerChoiceText: You should rest.
      npcResponse: Rest is where it gets in. If I stop walking, I stop being me.
      npcFollowUp: 
      animationTrigger: Talk1
      playLaughSfx: 0
  - type: 1
    npcLine: There's a story in my satchel. The first thing I've finished in years.
    animationTrigger: Talk3
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Who's it for?
      npcResponse: The officer at the gate. Read it when I'm gone, not before.
      npcFollowUp: 
      animationTrigger: Talk3
      playLaughSfx: 0
    - playerChoiceText: What's it about?
      npcResponse: A postman who forgot his own name. Not much of a plot.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: If I come back wrong, Officer, remember the postman. Not the rest.
    animationTrigger: Talk3
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
