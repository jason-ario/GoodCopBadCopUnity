%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: GiviDay3Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 0
  nodes:
  - type: 0
    npcLine: Officer. I saw what was left of Vlad this morning. I didn't stop.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: After the blast, I chased my burning pages [[whisper:into the green]]. It was warm.
    animationTrigger: Talk2
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Are you sick?
      npcResponse: I cough blood every morning. Then I put on my cap and deliver.
      npcFollowUp: 
      animationTrigger: FakeCough
      playLaughSfx: 0
    - playerChoiceText: Who else knows?
      npcResponse: Nobody. I told the soldiers I hid in the cellar. They stamped it.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 1
    npcLine: Last night I woke up on my route, satchel on. I don't remember leaving.
    animationTrigger: Talk3
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Where were you?
      npcResponse: At the pylons on the ridge. Listening to the wires hum.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Is it getting worse?
      npcResponse: Every morning there's a little less of me.
      npcFollowUp: 
      animationTrigger: TalkShrug
      playLaughSfx: 0
  - type: 0
    npcLine: Don't report me yet, Officer. Let me finish the route.
    animationTrigger: Talk3
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
