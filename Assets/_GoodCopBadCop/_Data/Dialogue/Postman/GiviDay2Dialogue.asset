%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: GiviDay2Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 0
  nodes:
  - type: 0
    npcLine: Morning, Officer. Forgive the [[infected:cough]]. Dust from the lower road.
    animationTrigger: FakeCough
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: I used to write stories, you know. Now I carry other people's.
    animationTrigger: Talk2
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What happened to yours?
      npcResponse: They burned the day of the blast. Twenty years of pages, gone.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Why did you stop?
      npcResponse: I didn't like where my story was going. So I picked up the satchel.
      npcFollowUp: 
      animationTrigger: TalkShrug
      playLaughSfx: 0
  - type: 1
    npcLine: Lately I find words in my head that aren't mine. Whole sentences.
    animationTrigger: Talk3
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: What kind of words?
      npcResponse: Directions, mostly. To a road my feet already seem to know.
      npcFollowUp: 
      animationTrigger: TalkLookAway
      playLaughSfx: 0
    - playerChoiceText: Have you seen a doctor?
      npcResponse: The doctor coughs worse than I do.
      npcFollowUp: 
      animationTrigger: TalkSarcasticNod
      playLaughSfx: 0
  - type: 0
    npcLine: Keep your water boiled, Officer. I'd hate to lose my best reader.
    animationTrigger: FakeCough
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
