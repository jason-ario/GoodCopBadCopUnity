%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: SoldierDay1Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: Oh, fantastic. Another fresh inspector. Straight out of the academy?
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: Three tours. I've seen that hopeful look before. You all lose it.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: So what did they prepare you for? Be honest.
    animationTrigger: TalkSarcasticNod
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: The basics. Enough to do the job.
      npcResponse: The basics. That'll keep you breathing for maybe two days.
      animationTrigger: TalkDismissing
    - playerChoiceText: Guess we'll find out.
      npcResponse: Ha. At least you're honest. You still won't last.
      animationTrigger: TalkShrug
  - type: 0
    npcLine: I'll be generous. Three days. Four if nothing shows up. And it will.
    animationTrigger: TalkDismissing
    cameraTrigger: LookUp
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: Last guy here saw something he couldn't explain. Nobody listened.
      Then he stopped talking too.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: So settle in, Inspector. Enjoy feeling in control while it lasts, before
      you...
    animationTrigger: 
    cameraTrigger: 
    wobbleText: 0
    choices: []
