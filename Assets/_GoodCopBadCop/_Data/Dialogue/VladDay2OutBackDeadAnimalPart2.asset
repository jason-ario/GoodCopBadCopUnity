  nodes:
  - type: 0
    npcLine: Remember that flashlight I gave you? There's a UV light mode on there.
    animationTrigger: TalkDismissing
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: These fellas leave behind radioactive blood trails. You'll probably
      be able to see it with UV light.
    animationTrigger: TalkBigCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: I want you to follow the trail and see where it leads.
    animationTrigger: TalkPoint
    cameraTrigger: Gun
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: Take that gun. You'll probably need it.
    animationTrigger: TalkPoint
    cameraTrigger: Gun
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: Good luck!
    animationTrigger: TalkBigLaugh
    cameraTrigger: suspect face
    wobbleProfileOverride: {fileID: 0}
    choices: []
