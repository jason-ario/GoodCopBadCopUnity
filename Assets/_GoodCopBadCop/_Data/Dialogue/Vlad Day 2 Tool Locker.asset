  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: Vlad Day 2 Tool Locker
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: This here tool locker is where you can purchase tools.
    animationTrigger: TalkPoint
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: We'll give you some supplies every day in a supply box. So anything
      from this locker will be coming out of your paycheck.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: One more thing. The things you're going to see through that window...
      don't let it get to you. People who let it get to them end up on the other
      side of the glass.
    animationTrigger: TalkSlightSurprise
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: And one LAST thing. Clean up the graffiti on the walls outside.
    animationTrigger: TalkPoint
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: This is a government facility. Let's try to act like one.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
