  nodes:
  - type: 0
    npcLine: You persist. Noted.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: I have been processing every variable in this room. You are the last
      unresolved one.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: Your resistance is not meaningful data. It is a delay.
