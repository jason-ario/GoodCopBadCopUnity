  nodes:
  - type: 1
    npcLine: I know what is in there. Behind your jaw. Behind your sternum. I got
      full marks on the diagram.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices:
    - playerChoiceText: Miriam. Look at me.
      npcResponse: Nhhhhhh.
      animationTrigger: 
    - playerChoiceText: What do you want?
      npcResponse: Open the window. I only need a moment.
      animationTrigger: 
  - type: 0
    npcLine: My hands are different now. But I can still count every bone. I counted
      yours already.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: I am not finished studying yet.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
