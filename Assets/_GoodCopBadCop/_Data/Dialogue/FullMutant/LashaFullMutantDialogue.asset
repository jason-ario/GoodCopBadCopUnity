  nodes:
  - type: 0
    npcLine: Thirty years. Thirty years of this. You know what that does to a person?
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: I kept it in. I was professional. I was professional my whole life.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: You're doing that thing with your face. Don't look at me like that.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: DON'T LOOK AT ME LIKE THAT.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
