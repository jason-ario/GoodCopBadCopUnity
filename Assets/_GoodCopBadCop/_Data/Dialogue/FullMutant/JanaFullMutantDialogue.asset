  nodes:
  - type: 0
    npcLine: You came. I knew you'd come. He told me you would.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: He's been here the whole time. Since before. He was waiting for me.
      He never left.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: The flowers are finished. Everything is exactly as I planned it.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: Come inside. Please come inside. We're about to start. He wants to meet
      you properly.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
