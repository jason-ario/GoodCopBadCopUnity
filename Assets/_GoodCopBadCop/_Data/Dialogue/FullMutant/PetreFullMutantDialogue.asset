%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: PetreFullMutantDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: You know what happened to my dog.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 0
    npcLine: He came back through this checkpoint wrong. Something on your side of the glass touched him.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: The poems were never mine. He moved through me. I was only ever the pen.
    animationTrigger: TalkIdle
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Petre, step away from the window.
      npcResponse: In a moment. I am in the middle of something. He is. We are.
      animationTrigger: TalkCocky
      playLaughSfx: 0
    - playerChoiceText: Your dog is alive. I've seen him.
      npcResponse: You've seen what he is now. You did that. This place did that.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: A pen doesn't grieve. I have. The next line is His, not mine.
    animationTrigger: TalkIdle
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
