  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: PavleFullMutantDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: Permit. Right. Force of habit. The gauze came off last week.
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 0
    npcLine: The skin grew around the edges. The grinding was never from the shop.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: The hunger got very specific. Like I told you it would.
    animationTrigger: TalkCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Pavle, step back from the window.
      npcResponse: In a moment. I've been looking forward to this.
      animationTrigger: TalkSmile
      playLaughSfx: 0
    - playerChoiceText: What do you want?
      npcResponse: Something fresh. I've been very patient.
      animationTrigger: TalkCocky
      playLaughSfx: 0
  - type: 0
    npcLine: You were always very good to me. You'd make a {{very clean cut}}.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
