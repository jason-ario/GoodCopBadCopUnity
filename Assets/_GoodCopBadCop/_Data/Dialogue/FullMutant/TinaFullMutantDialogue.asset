  nodes:
  - type: 0
    npcLine: "Here are my papers. I checked them twice. I always check them twice now."
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: "You can look at the mask. I don\u2019t mind. I noticed I stopped minding
      a while ago."
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: "I have been through this checkpoint before. I remember it. I remember
      most things, I think."
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: "Let me know when you\u2019re finished. I will wait. I am very good at
      waiting."
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
