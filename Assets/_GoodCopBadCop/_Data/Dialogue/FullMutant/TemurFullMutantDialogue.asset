  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: TemurFullMutantDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: I found you this morning. Tracked you in from the eastern approach.
      You left marks.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: The city used to smell like people. Now it smells like what comes after
      people.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: I've been waiting in the same spot for three days. That doesn't bother
      me.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: Nothing has bothered me since I went back into the ground.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
