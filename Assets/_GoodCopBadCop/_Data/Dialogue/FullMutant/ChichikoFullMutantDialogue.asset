%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: ChichikoFullMutantDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: I have been working on something. You can look. I want you to look.
    animationTrigger: TalkBigCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 1
    npcLine: Well?
    animationTrigger: TalkBigCocky
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    choices:
    - playerChoiceText: You look... impressive.
      npcResponse: No. You are lying. I can always tell when someone is lying about
        this. Your left eye moved.
      animationTrigger: TalkPoint
    - playerChoiceText: What happened to you?
      npcResponse: What HAPPENED? I improved. This is improvement. You will say it
        differently.
      animationTrigger: TalkBigCocky
  - type: 0
    npcLine: I made the standards myself. Nobody else had acceptable ones.
    animationTrigger: TalkDismissing
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: I am not done. Whatever you think you are looking at right now, it is
      not finished yet.
    animationTrigger: TalkPoint
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    choices: []
