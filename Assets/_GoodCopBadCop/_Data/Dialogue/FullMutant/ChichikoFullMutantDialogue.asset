  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: ChichikoFullMutantDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: I have been working on something. Look. I want you to look.
    animationTrigger: TalkBigCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Well?
    animationTrigger: TalkBigCocky
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: You look... impressive.
      npcResponse: Lying. Your left eye moved.
      animationTrigger: TalkPoint
      playLaughSfx: 0
    - playerChoiceText: What happened to you?
      npcResponse: '[[infected:I improved]]. You will say it differently.'
      animationTrigger: TalkBigCocky
      playLaughSfx: 0
  - type: 0
    npcLine: I am not done. Whatever you are looking at, it is not finished.
    animationTrigger: TalkPoint
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
