  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: SandroFullMutantDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: The sunset from here is extraordinary. I wish you could see it.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: I've been trying to get back. But the road keeps going. I follow it.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: I wrote you something. I don't remember writing it. Here.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: Don't be sad. It's very beautiful where I am. Very quiet. You'll see.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
