%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: SandroFullMutantDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: The light is extraordinary. You should see it from where I am. The same sunset, for months.
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 0
    npcLine: Sorry, I was talking to someone. He says you should be careful.
    animationTrigger: TalkIdle
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: Don't be sad. It's very quiet where I am. You'll [[whisper:understand eventually]].
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Sandro, come back.
      npcResponse: I've been trying. The road doesn't seem to go that direction.
      animationTrigger: TalkLookDown
      playLaughSfx: 0
    - playerChoiceText: Who were you talking to?
      npcResponse: He's been there the whole time. He says hello. He says goodbye.
      animationTrigger: TalkLookAway
      playLaughSfx: 0
  - type: 0
    npcLine: I wrote you something. I don't remember writing it. Keep it.
    animationTrigger: TalkPoint
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
