  nodes:
  - type: 0
    npcLine: Oh, sweetheart. Look at the state of you. Come here. Come here.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: Everyone comes through here so broken. And nobody ever asks for help.
      They just keep going.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: I can fix this. I can fix all of it. I just need you to let me.
    animationTrigger: 
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: Come closer. A little closer. I just need to reach you. That's all.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
