  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: ShotaFullMutantDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: I have been waiting for you. I have been waiting for all of you.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: I know what is coming. The knowing burned everything away that wasn't
      essential. I'm grateful.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: I've given last rites. For everyone in the town. Don't be alarmed. It
      was a blessing.
    animationTrigger: 
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: Be not afraid. I have loved you all very, very much. And I am about
      to demonstrate that.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
