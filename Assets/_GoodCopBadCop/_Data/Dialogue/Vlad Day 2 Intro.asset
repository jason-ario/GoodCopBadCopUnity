  nodes:
  - type: 0
    npcLine: It's about time you woke up. What are we paying you for?
    animationTrigger: TalkBigCocky
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: I brought you a box of supplies. Should help you with the new anomalies
      we've been seeing.
    animationTrigger: TalkPoint
    cameraTrigger: SupplyBox
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: Messed up shit. People are starting to mutate. We're talking multiple
      arms, tumors, all sorts of shit.
    animationTrigger: TalkBigLaugh
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: Follow me, I got something to show you.
    animationTrigger: TalkDismissing
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
