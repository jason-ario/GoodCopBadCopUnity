%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: IvanDay1Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: Oh! A new face! First day, yes? I can always tell — wide eyes. I love
      wide eyes!
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: Ivan Tarkov. Factory worker. Third block. Same time, same smile every
      evening. Reliable as a clock!
    animationTrigger: TalkIdle
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: The officer before you — very sharp. Very dedicated. Then one day he
      just... stopped showing up. These things happen, I suppose!
    animationTrigger: TalkLookAway
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 1
    npcLine: Do you enjoy meeting people in this work? I think it's the best part!
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices:
    - playerChoiceText: It's part of the job.
      npcResponse: Give it time. Every face becomes memorable. Some more than others.
        Naturally.
      animationTrigger: TalkCocky
    - playerChoiceText: People are interesting.
      npcResponse: "Yes! And the best part \u2014 they never notice when someone's
        paying very close attention. Ha!"
      animationTrigger: TalkSmile
  - type: 0
    npcLine: You should smile more. A smile makes even the most guarded person feel
      at ease. Wonderful tool.
    animationTrigger: TalkSmile
    cameraTrigger: 
    wobbleText: 0
    choices: []
  - type: 0
    npcLine: But you have work to do. Here are my papers. Everything in order, as
      always. I am a very tidy person.
    animationTrigger: TalkPoint
    cameraTrigger: 
    wobbleText: 0
    choices: []
