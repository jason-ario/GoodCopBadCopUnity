  m_Script: {fileID: 11500000, guid: 9bc4902ccea98cf44865aecb61fc1ff4, type: 3}
  m_Name: Nini
  m_EditorClassIdentifier: Assembly-CSharp::SuspectData
  FirstName: Nini
  LastName: Bitsadze
  Nickname: 
  Occupation: Artist
  CharacterDescription: Blunt and mysterious
  CharacterArc: Vibrant, expressive, and slightly paint-stained. Her arc is about artistic obsession. As the world loses its color and structure, she becomes fixated on capturing the shifting light and the strange geometry of the decay, viewing the apocalypse as a fleeting masterpiece she must document before the lights go out.
  DateOfBirth: 05/02/1966
  Sex: Female
  EntryPermitExpiryDate: 10 DEC
  IsResident: 1
  GivesPaperwork: 1
  handwritingFont: {fileID: 11400000, guid: f8e89ead54f8523428cc2e34f005bb5e, type: 2}
  startingInfectionScore: 0
  dailyInfectionProgression: {x: 8, y: 18}
  alterEgoName: The Masked Lady
  basePersonalityDescriptors:
  - Artist. Paints and sketches in charcoal; her hands are never clean of it.
  - "Blunt and mysterious \u2014 short, direct answers, rarely volunteers anything about herself."
  - Has a managed medical condition. Her caretaker Tamar checks on her every morning.
  - Obsessed with the changing light since the dust began falling. Treats the decay as a subject to capture.
  - Keeps her documents inside her sketchbook, separate from the charcoal pages.
  normalBehaviorNotes: "In her base state Nini is blunt and hard to read. She answers exactly what is asked and nothing more, then drifts back to studying the light, the booth, or your face as a subject. Charcoal and paint on her hands are constant; she explains them before you can. She has a managed medical condition and a caretaker, Tamar, who checks on her in the mornings. Watch for the moment her detachment becomes obsession \u2014 when she stops answering questions and starts describing colours."
  fullMutantDialogue: {fileID: 11400000, guid: fc589bf86ac28314cb9dd57b94362e9a, type: 2}
  replacementIDPhoto: {fileID: 0}
  IDPhoto: {fileID: 2800000, guid: 0a1d83fdb3fe4574990eee09aeaac946, type: 3}
  CharacterPrefab: {fileID: 793074409391834654, guid: afd46dd979f4ef9429d317cb91da466c, type: 3}
  entryReasons:
    earlyDaysReasons:
    - Finishing a commissioned portrait.
    - Pharmacy, then gallery storeroom. Home.
    - Picking up fresh canvases.
    midDaysReasons:
    - Three pharmacies. Got half. Home.
    - To my studio. The violet won't wait.
    - Home for charcoal. The light is changing.
    finalDaysReasons:
    - To my studio roof. The light is dying.
    - Home to finish my final canvas.
    - Mandatory resident census.
  invalidEntryReasons:
    earlyDaysReasons:
    - Home from my bank shift. Numbers all day.
    - Home to care for my grandmother.
    - Selling my paints. I quit years ago.
    midDaysReasons:
    - Threw my pills away. Never needed them.
    - Going to sleep. Colours bore me.
    - Back from engineering night classes.
    finalDaysReasons:
    - Home to rest. Light doesn't matter.
    - Collecting my post office pension.
    - Going home to burn my sketchbooks.
  entryDialogues:
    lastVerdict: 0
    dialoguesEarlyDays:
    - My documents. Sorry about the charcoal smudges.
    - The shadows across your booth are quite striking today.
    dialoguesMidDays:
    - The sky is a violet that shouldn't exist. Have you noticed?
    - Hurry, please. The horizon is melting. I must paint it.
    dialoguesFinalDays:
    - The world is finally becoming the abstract piece I dreamed of.
    - Out of red paint. The sunset provides plenty.
  uncannyEntryDialogues:
    lastVerdict: 0
    dialoguesEarlyDays:
    - Here. She sets the papers down without looking.
    - You want something. Everyone does.
    dialoguesMidDays:
    - She does not speak. She just watches you.
    - The papers are down before you ask.
    dialoguesFinalDays:
    - Take them. She has not blinked in some time.
    - She stands very still. Waiting. Too long.
  exitDialoguesPassed:
    lastVerdict: 1
    dialoguesEarlyDays:
    - Stay in the light. Better composition there.
    dialoguesMidDays:
    - Good luck. Watch the colours. They're starting to bleed.
    dialoguesFinalDays:
    - I'll see you in the masterpiece. Don't blink.
  exitDialoguesQuarantined:
    lastVerdict: 2
    dialoguesEarlyDays: []
    dialoguesMidDays: []
    dialoguesFinalDays: []
  exitDialoguesKilled:
    lastVerdict: 3
    dialoguesEarlyDays: []
    dialoguesMidDays: []
    dialoguesFinalDays: []
  quarantineExitLines:
  - A white room with good lighting? Fine. Absolutely fine.
  - Great artists all get imprisoned. Very on-brand.
  killExitLines:
  - "I hadn\u2019t signed the last canvas\u2026 It needed one more pass\u2026"
  - "All that light and I never\u2026 quite captured it\u2026"
  voiceAudioClips:
  - {fileID: 8300000, guid: e84fb141c1e8ae04f9ceabd92077e275, type: 3}
  - {fileID: 8300000, guid: a46971d9694b4cd4fb94c9034f99e09a, type: 3}
  - {fileID: 8300000, guid: 4ce78aef8f10708459270013be872166, type: 3}
  - {fileID: 8300000, guid: c19d065f3b0b561439cbcae3022977c3, type: 3}
  - {fileID: 8300000, guid: bb8afd8c4ca0b9943bad4521c8501d09, type: 3}
  - {fileID: 8300000, guid: 18f8f7eea7a89ae4db076e468b8753cc, type: 3}
  - {fileID: 8300000, guid: c706aae5d29a394448fbf01f7293390f, type: 3}
  - {fileID: 8300000, guid: 5fb919cce67b00f4c9fcbce46aea30bb, type: 3}
