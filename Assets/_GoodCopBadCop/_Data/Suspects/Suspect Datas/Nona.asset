  m_Script: {fileID: 11500000, guid: 9bc4902ccea98cf44865aecb61fc1ff4, type: 3}
  m_Name: Nona
  m_EditorClassIdentifier: Assembly-CSharp::SuspectData
  FirstName: Nona
  LastName: Beridze
  Nickname: 
  Occupation: Census Recorder
  CharacterDescription: Still, unblinking, smiles at the wrong moments, always knows
    too much
  CharacterArc: Late 30s, probably. It is difficult to be certain. Nona has worked
    as a census recorder for eleven years, quietly cataloguing who lives where, who
    has moved, who has died. She always knows exactly where to look. She holds eye
    contact for slightly too long and smiles when people do not finish their sentences,
    as if she already knows what they were going to say. Nothing she says is technically
    wrong. Nothing she does is technically alarming. But everyone who passes through
    leaves with a faint, unexplainable discomfort they cannot put into words.
  DateOfBirth: 07/07/1987
  Sex: Female
  EntryPermitExpiryDate: 07 JUL
  IsResident: 1
  GivesPaperwork: 1
  handwritingFont: {fileID: 0}
  startingInfectionScore: 0
  dailyInfectionProgression: {x: 12, y: 28}
  alterEgoName: 
  basePersonalityDescriptors: []
  normalBehaviorNotes: 
  fullMutantDialogue: {fileID: 11400000, guid: 59d5d74baae6065439501549d96fbefd, type: 2}
  replacementIDPhoto: {fileID: 0}
