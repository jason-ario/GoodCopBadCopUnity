    dialoguesFinalDays: []
  quarantineExitLines:
  - A den. I have slept in worse. I will wait.
  - Watch the door. Things follow you more than you think.
  killExitLines:
  - "Back to the roots\u2026 the dark soil\u2026 This is\u2026 correct."
  - "The predator\u2026 always finds you\u2026 in the end\u2026"
