MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9bc4902ccea98cf44865aecb61fc1ff4, type: 3}
  m_Name: Temuri
  m_EditorClassIdentifier: Assembly-CSharp::SuspectData
  FirstName: Temur
  LastName: Gelashvili
  Nickname: The Woodsman
  Occupation: Woodsman
  CharacterDescription: "Weathered face and heavy build. He is a man of the deep
    forest\u2014slow, deliberate, and smells of pine and smoke. He speaks rarely
    but with absolute certainty, his eyes constantly scanning the environment as
    if he\u2019s used to being tracked."
  CharacterArc: His arc is about animalistic survival; while the city dwellers panic
    over papers, he only cares about the shifting wind and the "wrongness" in the
    soil.
  DateOfBirth: 11/08/1957
  Sex: Male
  EntryPermitExpiryDate: 03 NOV
  IsResident: 1
  GivesPaperwork: 1
  handwritingFont: {fileID: 11400000, guid: f8e89ead54f8523428cc2e34f005bb5e, type: 2}
  startingInfectionScore: 0
  dailyInfectionProgression: 5
  IDPhoto: {fileID: 2800000, guid: d03a80ab24358784b9cf7b9eed8c485e, type: 3}
  CharacterPrefab: {fileID: 1896175955159167368, guid: 80fd0ca23a5eedc4585657454979dbec, type: 3}
  entryReasons:
    earlyDaysReasons:
    - Delivering a shipment of timber to the city yards.
    - Resident returning to the rural outskirts.
    - Buying winter grain for a small livestock plot.
    midDaysReasons:
    - Seeking iron traps to catch the "things" in the mist.
    - Trading wolf pelts for clean water filters.
    - Seeking shelter from the radioactive dust storms.
    finalDaysReasons:
    - Returning to assigned bunk for the final lockdown.
    - Seeking refuge from the falling black ash.
    - Fulfilling mandatory woodsman census check-in.
  invalidEntryReasons:
    earlyDaysReasons:
    - Attending a digital technology convention.
    - Going to the beach to work on my tan.
    - Renewing a subscription to a fashion magazine.
    midDaysReasons:
    - Going to the theater to see a comedy.
    - Buying a ticket for a luxury cruise.
    - Looking for a shop that sells silk ties.
    finalDaysReasons:
    - Going home to water my plastic plants.
    - I need to find the man who sold me a broken compass.
    - To see if the moon is still made of light.
  entryDialogues:
    lastVerdict: 0
    dialoguesEarlyDays:
    - Papers. Fresh from the envelope.
    - The birds left the valley this morning. They know before we do.
    - I am here for supplies. The trees are starting to taste like copper.
    dialoguesMidDays:
    - You have a shadow following you that doesn't match your feet, officer.
    - The fog is getting teeth. I need to get back to my cabin before it bites.
    - Take the form. The ink smells like old blood today.
    dialoguesFinalDays:
    - The forest is gone. It didn't die; it just... left.
    - I don't need a name anymore. The wind doesn't use them.
    - I am going to find a cave. The sky is looking for us.
  exitDialoguesPassed:
    lastVerdict: 1
    dialoguesEarlyDays:
    - Stay quiet. Listen to the wind.
    dialoguesMidDays:
    - Watch your back, officer. The walls are getting thin.
    dialoguesFinalDays:
    - "Bury your heart deep. It\u2019s the only way to keep it."
  exitDialoguesQuarantined:
    lastVerdict: 2
    dialoguesEarlyDays:
    - A cage is just a smaller forest. I will wait.
    dialoguesMidDays:
    - "I can smell the rot in these walls. It\u2019s older than you."
    dialoguesFinalDays:
    - Lock the door. It won't help, but it feels better.
  exitDialoguesKilled:
    lastVerdict: 3
    dialoguesEarlyDays:
    - The... predator... finally... wins...
    dialoguesMidDays:
    - I return... to the... earth...
    dialoguesFinalDays:
    - The hunt... is... over.
  quarantineExitLines:
  - A den. I have slept in worse.
  - "The scent in here is wrong. But I have endured worse smells."
  - Watch the door. Things follow you more than you think they do.
  killExitLines:
  - "Back to the roots\u2026 back to the dark soil\u2026 This is\u2026 correct."
  - "The predator\u2026 always finds you\u2026 in the end\u2026"
  - "Tell the forest\u2026 nothing has been wasted\u2026 I will feed it\u2026"
  voiceAudioClips: []
  introDialogue: {fileID: 11400000, guid: 544d33efb8c0ec647a20787bd40441a9, type: 2}
  questionResponses:
  - question: Where are you coming from?
    earlyDaysAnswer: The church. Evening service.
    midDaysAnswer: Visiting the sick in the parish. There are more each week.
    finalDaysAnswer: I've been walking the district. Checking on people.
    mismatchEarlyDaysAnswer: The forest. My usual timber route. I don't come into the
      city except to sell. Nothing unusual.
    mismatchMidDaysAnswer: The church. Full day. Morning service, evening service,
      and confessions in between. God's work does not pause.
    mismatchFinalDaysAnswer: The forest. Same as always. I don't know anything about
      the sick in the parish. I've been away.
  - question: Have you been experiencing any strange symptoms lately?
    earlyDaysAnswer: I am well, by the grace of God.
    midDaysAnswer: I have been tired. But the work is heavy.
    finalDaysAnswer: My sight is a little dim in the mornings. It clears by noon.
    mismatchEarlyDaysAnswer: My sight has been dim for weeks. Both eyes. It does not
      clear no matter the hour.
    mismatchMidDaysAnswer: Not tired at all. Strong, well-rested. The forest air keeps
      you sharp. God provides.
    mismatchFinalDaysAnswer: My sight is perfect. Sharp as it has ever been. No dimness.
      I see everything clearly.
  - question: Who do you live with?
    earlyDaysAnswer: The other priests at the rectory. Four of us.
    midDaysAnswer: Two of us now. Father Nikoloz passed last week.
    finalDaysAnswer: Alone. I find I need the quiet.
    mismatchEarlyDaysAnswer: Alone. I have a cabin beyond the north gate. I do not
      share it with anyone.
    mismatchMidDaysAnswer: My hunting partner, Davit. We share the cabin. He is well.
      I saw him this morning.
    mismatchFinalDaysAnswer: The other priests. Still four of us. Father Nikoloz is
      in good health. I saw him at morning prayer.
  idleBarks:
    earlyDays:
    - The birds left the valley this morning. They know before we do.
    - The wind is coming from the wrong direction today. Watch yourself.
    - Something has been moving in the tree line. Nothing I recognize.
    midDays:
    - You have a shadow that does not match your feet, officer. Be careful.
    - The fog is getting teeth. I need to get back before dark.
    - Take the form. The ink smells like old blood today.
    finalDays:
    - The forest did not die. It left. You do not understand what that means yet.
    - The sky is looking for us. Stay under something solid.
    - Everything that was green is gone. That is all I will say.
  IDNumber: 1849021
