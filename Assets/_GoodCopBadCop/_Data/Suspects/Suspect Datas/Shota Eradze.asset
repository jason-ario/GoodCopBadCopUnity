  introDialogue: {fileID: 11400000, guid: a2487dfb69806694d9657932307e14e3, type: 2}
  questionResponses:
  - question: Where are you coming from?
    answer: The east district water lines since dawn, brother. Then evening prayers.
    mismatchAnswer: My mountain monastery. I live alone up there. I rarely come down.
    uncannyAnswer: 
    cameraTrigger: 
  - question: Are you experiencing any symptoms?
    answer: The spirit is willing, brother. The body is only tired. Nothing more.
    mismatchAnswer: None. I have not left my bed in days. Rest was all I needed.
    uncannyAnswer: 
    cameraTrigger: 
  idleBarks:
  - You look tired, Officer. I'll mention you in my prayers tonight.
  - Someone has to hold the line. I'm glad it's someone like you.
