  introDialogue: {fileID: 11400000, guid: 2b51582647a3f8340ac72eb350384322, type: 2}
  questionResponses:
  - question: Where are you coming from?
    answer: The parish above the north ridge. Road was clear. Dog stayed home.
    mismatchAnswer: My flat behind the bread factory. Town all my life. Mountains bore me.
    uncannyAnswer: 
    cameraTrigger: 
  - question: Are you experiencing any symptoms?
    answer: I sleep poorly. Always have. Otherwise, no.
    mismatchAnswer: None. I sleep like a child. Nothing keeps me awake.
    uncannyAnswer: 
    cameraTrigger: 
  - question: Has the dog come inside?
    answer: No. He stands at the tree line all night. He doesn't bark anymore.
    mismatchAnswer: A dog? No dog. My flat's too small for one.
    uncannyAnswer: 
    cameraTrigger: 
  idleBarks:
  - I write when I can't sleep. Lately I can't sleep much.
  - Quiet suits me. I don't say that as a complaint.
  uncannyIdleBarks: []
