    lastVerdict: 0
    dialoguesEarlyDays: []
    dialoguesMidDays: []
    dialoguesFinalDays: []
  exitDialoguesPassed:
    lastVerdict: 1
    dialoguesEarlyDays:
    - Good. Everything should run this smoothly.
    dialoguesMidDays:
    - I will tell my block. They worry unnecessarily.
    dialoguesFinalDays:
    - My daughters are waiting. Thank you for being thorough.
  exitDialoguesQuarantined:
