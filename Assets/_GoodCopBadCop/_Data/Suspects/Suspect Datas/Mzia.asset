  m_Script: {fileID: 11500000, guid: 9bc4902ccea98cf44865aecb61fc1ff4, type: 3}
  m_Name: Mzia
  m_EditorClassIdentifier: Assembly-CSharp::SuspectData
  FirstName: Mzia
  LastName: Kakulia
  Nickname: Granny
  Occupation: Seamstress
  CharacterDescription: Frail, kind expression, shaky hands. Typical grandma babushka.
  CharacterArc: 'Mzia has outlived two husbands, one war, and a dozen winters that
    were supposed to break her. She treats the apocalypse the same way she treats
    everything: with warm soup, small kindnesses, and a stubborn refusal to acknowledge
    that anything is truly beyond mending. As the world darkens she simply keeps
    stitching, convinced that if she finishes the sweater, something must still be
    waiting to wear it.'
  DateOfBirth: 19/10/1933
  Sex: Female
  EntryPermitExpiryDate: 21 NOV
  IsResident: 1
  GivesPaperwork: 1
  handwritingFont: {fileID: 11400000, guid: f8e89ead54f8523428cc2e34f005bb5e, type: 2}
  startingInfectionScore: 0
  dailyInfectionProgression: {x: 12, y: 28}
  alterEgoName: 
  basePersonalityDescriptors: []
  normalBehaviorNotes: 
  fullMutantDialogue: {fileID: 11400000, guid: f758c5ae5d58e05418f71a5ba974c5cd, type: 2}
  replacementIDPhoto: {fileID: 0}
