    lastVerdict: 0
    dialoguesEarlyDays: []
    dialoguesMidDays: []
    dialoguesFinalDays: []
  exitDialoguesPassed:
    lastVerdict: 1
    dialoguesEarlyDays:
    - See you tomorrow! I'll bring something special. Maybe.
    dialoguesMidDays:
    - Keep that neck straight, officer. Posture matters.
    dialoguesFinalDays:
    - Thanks, comrade. Keep out of trouble now!
