    dialoguesMidDays: []
    dialoguesFinalDays: []
  exitDialoguesPassed:
    lastVerdict: 1
    dialoguesEarlyDays:
    - Cool. Have a fun time in your little box, officer.
    dialoguesMidDays:
    - "Right. I\u2019m going to go stare at a wall now."
    dialoguesFinalDays:
    - Whatever. See you when the lights go out for good.
