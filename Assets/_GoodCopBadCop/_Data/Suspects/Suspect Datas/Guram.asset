    lastVerdict: 0
    dialoguesEarlyDays: []
    dialoguesMidDays: []
    dialoguesFinalDays: []
  exitDialoguesPassed:
    lastVerdict: 1
    dialoguesEarlyDays:
    - Good. Another shift done, then. Thank you.
    dialoguesMidDays:
    - Right. Back to the empty block, then.
    dialoguesFinalDays:
    - Finally. Nowhere to be, but finally, officer.
