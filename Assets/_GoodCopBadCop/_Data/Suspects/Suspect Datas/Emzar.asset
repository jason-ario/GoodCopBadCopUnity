  introDialogue: {fileID: 11400000, guid: 212d303125ea9c240a5729652639a37a, type: 2}
  questionResponses:
  - question: Where are you coming from?
    answer: The apiary. East side. I cleaned frames. The bees were... quiet. Good day.
    mismatchAnswer: The honey cooperative, west district. I am... the master there. I run it.
    uncannyAnswer: 
    cameraTrigger: 
  - question: Are you experiencing any symptoms?
    answer: My chest is... tight. Dust from the site. The foreman says so.
    mismatchAnswer: No. My chest is... clear. I do not work at any site.
    uncannyAnswer: 
    cameraTrigger: 
  idleBarks:
  - The bees are... very restless today. More than usual.
  - You do not smell like smoke. That is... unusual. In a good way.
