  m_Name: The Priest
  m_EditorClassIdentifier: Assembly-CSharp::SuspectData
  FirstName: Shota
  LastName: Eradze
  Nickname: The Priest
  Occupation: Priest
  CharacterDescription: 'Calm, composed, intense stare. Intense, energetic, and deeply
    empathetic. He is not a distant figurehead but a "street priest" who is constantly
    on the move. '
  CharacterArc: "His arc is about radical martyrdom; as the world falls apart, he
    becomes more desperate to save souls, treating every interaction\u2014even a
    border check\u2014as a vital moment of human connection. He is warm but has a
    piercing gaze that makes you feel like he\u2019s looking at your conscience."
  DateOfBirth: 21/06/1948
  Sex: Male
  EntryPermitExpiryDate: 22 DEC
  IsResident: 1
  GivesPaperwork: 1
  handwritingFont: {fileID: 11400000, guid: f8e89ead54f8523428cc2e34f005bb5e, type: 2}
  startingInfectionScore: 0
