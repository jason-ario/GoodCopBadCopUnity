  quarantineExitLines:
  - "I\u2019m not infected. I\u2019ve been so careful. So incredibly careful."
  - "Please don\u2019t tell my parents. They\u2019ll just worry more. Please."
  killExitLines:
  - "I wasn\u2019t ready\u2026 I still had things\u2026 I still had things\u2026"
  - "I want my mom\u2026 I just\u2026 I want my mom\u2026"
