  introDialogue: {fileID: 11400000, guid: 5b17e3fdf6196354dad34cc70d2ac032, type: 2}
  questionResponses:
  - question: Where are you coming from?
    answer: A client near the station. Ledgers. Nothing to interest you.
    mismatchAnswer: My mother's flat in Rustavi. She cooks for me every Sunday.
    uncannyAnswer: I was already here. Before you sat down.
    cameraTrigger: 
  - question: Are you experiencing any symptoms?
    answer: Nothing. The mask covers old scars, not fever. Stop staring.
    mismatchAnswer: Nothing. The mask is for show. At home, it's off.
    uncannyAnswer: No. Ask again. The answer will still be no.
    cameraTrigger: 
  idleBarks:
  - You keep staring. Most people have manners.
  - The family section is blank on purpose. Note it down.
