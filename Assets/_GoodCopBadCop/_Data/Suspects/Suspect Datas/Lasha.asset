  IDPhoto: {fileID: 2800000, guid: d5651fdd6900dd14fa45f1adfa3633ca, type: 3}
  CharacterPrefab: {fileID: 199770865469659255, guid: 6e920bda57f6de84eba63381a300818a, type: 3}
  entryReasons:
    earlyDaysReasons:
    - Returning home after a twelve-hour driving shift.
    - Resident returning to the western residential district.
    - Dropping off the car at the fleet garage for repairs.
    midDaysReasons:
    - Escaping the heavy smog.
    - Checking on the security of my apartment building.
    - Seeking shelter from the radioactive fallout.
    finalDaysReasons:
    - Seeking refuge from the falling ash.
    - Returning home.
    - Fulfilling mandatory residency check-in.
  invalidEntryReasons:
    earlyDaysReasons:
    - Renewing a taxi license at the public library.
    - Taking a shortcut through the high-security bunker.
    - Picking up a passenger at the abandoned airport.
    midDaysReasons:
    - Looking for a gas station that hasn't been looted.
    - Driving a fare to a bridge that collapsed yesterday.
    - Picking up a spare tire from the grocery store.
    finalDaysReasons:
    - Going home to wait for the radio to stop screaming.
    - I need to find the guy who dented my fender.
    - To sit in my car and honk until the sky breaks.
  entryDialogues:
    lastVerdict: 0
    dialoguesEarlyDays:
    - "Move it along, officer. I\u2019ve got a fare waiting and time is money."
    - What, you need to see my teeth too? Just check the damn paper.
    - "This town is going to hell because everyone\u2019s standing around asking
      questions."
    dialoguesMidDays:
    - My car won't start and the streets are full of junk. You happy now?
    - "Don't look at me like that. I\u2019ve dealt with tougher guys than you before
      breakfast."
    - "You think this booth makes you special? We\u2019re all breathing the same
      poison."
    dialoguesFinalDays:
    - "Go ahead, keep me here. There\u2019s nowhere left to drive anyway."
    - "You\u2019re just a glorified bouncer for a club that\u2019s currently burning
      down."
    - "I hope you\u2019re proud of your little rubber stamp. It\u2019s all you\u2019ll
      have left soon."
  exitDialoguesPassed:
    lastVerdict: 1
    dialoguesEarlyDays:
    - Finally. Try to work a bit faster next time, yeah?
    dialoguesMidDays:
    - "Yeah, yeah. Watch your back out here. It\u2019s getting ugly."
    dialoguesFinalDays:
    - Whatever. Enjoy your little cage while it lasts.
  exitDialoguesQuarantined:
    lastVerdict: 2
    dialoguesEarlyDays:
    - "You\u2019re kidding me. I don't have time for this circus!"
    dialoguesMidDays:
    - Lock me up then. At least I won't have to look at your face.
    dialoguesFinalDays:
    - "Fine. It\u2019s probably quieter in there than it is out here."
  exitDialoguesKilled:
    lastVerdict: 3
    dialoguesEarlyDays:
    - "Hey! What are you\u2014!"
    dialoguesMidDays:
    - I knew you were looking for an excuse to pull that trigger!
    dialoguesFinalDays:
    - About time... someone... shut the world... up.
  voiceAudioClips: []
  questionResponses:
  - question: Where are you coming from?
    earlyDaysAnswer: The garage. I do repairs. Slow day.
    midDaysAnswer: A call-out on the south side. People still need their cars fixed
      I suppose.
    finalDaysAnswer: The garage. I keep going even though nobody's coming in.
  - question: Have you been experiencing any strange symptoms lately?
    earlyDaysAnswer: My nose won't stop running. The fumes at the garage, probably.
    midDaysAnswer: I've been getting dizzy. Short spells. Nothing serious.
    finalDaysAnswer: My ears ring now. Constantly. It's hard to concentrate.
  - question: Who do you live with?
    earlyDaysAnswer: My wife and two kids. Good family.
    midDaysAnswer: My wife. The kids are at her parents' place for now.
    finalDaysAnswer: My wife. She's been very quiet lately. We both have.
  IDNumber: 3442788
