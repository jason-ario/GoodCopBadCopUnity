  m_Name: Vlad
  m_EditorClassIdentifier: Assembly-CSharp::SuspectData
  FirstName: Vladimir
  LastName: Syrnikov
  Nickname: Mafia Boss
  Occupation: Businessman
  CharacterDescription: "An enormous, intimidating man who exudes confidence. He
    maintains unwavering, aggressive eye contact and speaks with the smooth, dangerous
    authority of someone who owns the city\u2014and everyone in it."
  CharacterArc: His arc is about predatory control; he treats the checkpoint like
    a minor inconvenience, subtly threatening the player while implying that the
    law is just a suggestion for a man of his stature.
  DateOfBirth: 15/05/1955
  Sex: Male
  EntryPermitExpiryDate: 28 DEC
  IsResident: 1
  GivesPaperwork: 1
  handwritingFont: {fileID: 11400000, guid: f8e89ead54f8523428cc2e34f005bb5e, type: 2}
