--- !u!114 &1642559636
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1642559635}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9493ccce3d55ff24aa89a1e58a5871c6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SuspectWorldDialogue
  daySets:
  - day: 1
    greetingLine: You picked a good spot to loiter, officer. Something on your mind?
    options:
    - playerLine: What are you doing out here?
      npcResponse: Getting some air. A man like me needs to breathe something that
        isn't recycled twice.
      animationTrigger: TalkShrug
    - playerLine: Are you causing any trouble?
      npcResponse: Trouble finds me. I don't have to go looking for it. Not yet,
        anyway.
      animationTrigger: TalkCocky
    - playerLine: Just checking in.
      npcResponse: Then check in and move along. I'm not going anywhere, officer.
      animationTrigger: TalkDismissing
  - day: 2
    greetingLine: Still babysitting the gate, officer? Things are getting interesting
      out here.
    options:
    - playerLine: You seem calmer than yesterday.
      npcResponse: Calm is a choice. Panic is for men who don't already own the exits.
      animationTrigger: TalkSarcasticNod
    - playerLine: Anything I should know about?
      npcResponse: Watch the yard. Something's been through here that wasn't human.
        Or wasn't anymore.
      animationTrigger: TalkLookAway
    - playerLine: Stay out of trouble.
      npcResponse: I always do. Trouble simply prefers my company.
      animationTrigger: TalkBigCocky
  suspectData: {fileID: 11400000, guid: dc830ace5de6bca429afec1f68e82c99, type: 2}
  manualOptions: []
  greetingLine: 
  speaking: {fileID: 1642559633}
