%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: Day02_Intro_Ocho
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  isForced: 1
  nodes:
  - type: 0
    npcLine: So. You're the one who decides who lives.
    animationTrigger: TalkCocky
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 0
    npcLine: Relax. Just enjoying the view from this side of the glass, for once.
    animationTrigger: TalkBigLaugh
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 1
    choices: []
  - type: 1
    npcLine: Your first kill. How'd it feel? Go on, humor me.
    animationTrigger: TalkPoint
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: Like doing my job.
      npcResponse: Your job. Sure. Keep telling yourself that, officer.
      animationTrigger: TalkBigLaugh
      playLaughSfx: 1
    - playerChoiceText: It felt terrible.
      npcResponse: Terrible. And yet here you are, back for another shift.
      animationTrigger: TalkSarcasticNod
      playLaughSfx: 0
  - type: 0
    npcLine: First one's always the loudest. Give it a week.
    animationTrigger: TalkDismissing
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: If I told you I was infected, would you even check? Or just... stamp?
    animationTrigger: TalkShrug
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: I'd check.
      npcResponse: Adorable. You almost believe that.
      animationTrigger: TalkBigCocky
      playLaughSfx: 0
    - playerChoiceText: Depends on my mood.
      npcResponse: NOW we're being honest. I like you already.
      animationTrigger: TalkBigLaugh
      playLaughSfx: 1
  - type: 0
    npcLine: Relax. I'm messing with you. Mostly.
    animationTrigger: ShortLaugh
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 1
    choices: []
  - type: 0
    npcLine: Papers are in order. Take a good look.
    animationTrigger: TalkDismissing
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    fontOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
