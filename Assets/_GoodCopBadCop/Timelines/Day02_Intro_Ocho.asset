  nodes:
  - type: 0
    npcLine: So. You're the one who decides who lives.
    animationTrigger: 
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    choices: []
  - type: 0
    npcLine: "I heard you pulled the trigger last week. Tell me \u2014 how did it
