%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec4ba6a512adabf4b8a74985cb2f4d14, type: 3}
  m_Name: Day02_Intro_Ocho
  m_EditorClassIdentifier: Assembly-CSharp::ScriptedDialogue
  nodes:
  - type: 0
    npcLine: So. You're the one who decides who lives.
    animationTrigger: TalkCocky
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 0
    npcLine: Relax, relax. I'm not applying for a job. Just admiring the view from
      this side of the glass, for once.
    animationTrigger: TalkBigLaugh
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    playLaughSfx: 1
    choices: []
  - type: 1
    npcLine: So tell me, how did it feel? Go on, humor me.
    animationTrigger: TalkPoint
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: It felt like doing my job.
      npcResponse: Ha! Your job. Sure. Keep telling yourself that, officer.
      animationTrigger: TalkBigLaugh
      playLaughSfx: 1
    - playerChoiceText: It felt terrible.
      npcResponse: Terrible? Then why'd your hand stop shaking by the second stamp?
      animationTrigger: TalkSarcasticNod
      playLaughSfx: 1
  - type: 0
    npcLine: Everyone says no the first time. Funny how nobody says no the second.
    animationTrigger: TalkDismissing
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    playLaughSfx: 1
    choices: []
  - type: 1
    npcLine: Here's a fun one. If I sat down right now and told you I was infected,
      would you even check? Or would you just... stamp?
    animationTrigger: TalkShrug
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: I'd check every time.
      npcResponse: Adorable. Absolutely adorable. You almost believe that.
      animationTrigger: TalkBigCocky
      playLaughSfx: 1
    - playerChoiceText: Depends on my mood.
      npcResponse: NOW we're being honest! See, I like you already.
      animationTrigger: TalkBigLaugh
      playLaughSfx: 1
  - type: 0
    npcLine: Relax. I'm messing with you. Mostly.
    animationTrigger: ShortLaugh
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    playLaughSfx: 1
    choices: []
  - type: 0
    npcLine: Let's talk business. I've got a few questions for YOU, for once.
    animationTrigger: TalkPoint
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
  - type: 1
    npcLine: First one, does it get easier? The killing, I mean. Or does it just
      get quieter?
    animationTrigger: TalkLookAway
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    playLaughSfx: 0
    choices:
    - playerChoiceText: It gets quieter.
      npcResponse: Quieter. I like that. Very poetic for a guy in a booth.
      animationTrigger: TalkSarcasticNod
      playLaughSfx: 1
    - playerChoiceText: I don't think about it.
      npcResponse: Not thinking about it IS the getting easier part, sweetheart.
      animationTrigger: TalkBigCocky
      playLaughSfx: 1
  - type: 0
    npcLine: Alright, alright, enough therapy. Let's get to the paperwork before
      I start crying.
    animationTrigger: ShortLaugh
    cameraTrigger: 
    wobbleProfileOverride: {fileID: 0}
    playLaughSfx: 1
    choices: []
  - type: 0
    npcLine: Anyway. Papers are all in order. Take a good look.
    animationTrigger: TalkDismissing
    cameraTrigger: SuspectFaceCam
    wobbleProfileOverride: {fileID: 0}
    playLaughSfx: 0
    choices: []
