  pseudoExpansion: 0.4
  forbiddenCharacters: 
  maxLengthRatio: 1.4
  fitLabelMin: 0.7
  fitHeaderMin: 0.6
  fitBodyMin: 0.75
  dialogueAssetTypes:
  - ScriptedDialogue
  - SuspectData
  - GuidebookDatabase
  onlyUsedDialogueAssets: 1
  onlyUsedPrefabs: 1
  dialogueFieldRules:
  - typeName: SuspectData
    fields:
    - entryReasons
    - invalidEntryReasons
    - entryDialogues
    - uncannyEntryDialogues
    - exitDialoguesPassed
    - exitDialoguesQuarantined
    - exitDialoguesKilled
    - quarantineExitLines
    - killExitLines
    - questionResponses
    - idleBarks
    - uncannyIdleBarks
  - typeName: GuidebookDatabase
    fields:
    - _rulesTabLabel
    - _rulePages
    - _scoringHeader
    - _scoringTitle
    - _scoringIntro
    - _dispositionBands
    - _dispositionWarning
    - _categories
    - _entries
    - _notesHeader
  fieldDenyList:
  - m_Name
  - animationTrigger
  - cameraTrigger
  - IDNumber
