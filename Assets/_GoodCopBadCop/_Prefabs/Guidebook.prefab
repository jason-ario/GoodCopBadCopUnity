    - target: {fileID: 7385412647217292329, guid: 3c65c5fcec52d6b4e8e210b612078d30, type: 3}
      propertyPath: m_text
      value: 'Issue a <b>QUARANTINE</b> when symptoms are present but uncertain.


        Quarantine allows us to cure their symptoms and prevents a subject from full mutation, unless they''re already past the point of no return.'
      objectReference: {fileID: 0}
    - target: {fileID: 7385412647217292329, guid: 3c65c5fcec52d6b4e8e210b612078d30, type: 3}
      propertyPath: m_fontSize
