      objectReference: {fileID: 0}
    - target: {fileID: 8236481025658057187, guid: 3c65c5fcec52d6b4e8e210b612078d30, type: 3}
      propertyPath: m_text
      value: "Reserved for subjects who pose an immediate and uncontainable threat.\n\nUse lethal force if presenting <b>10 OR MORE ANOMALIES</b>. \n\nUnjustified use is a protocol breach subject to review."
      objectReference: {fileID: 0}
    - target: {fileID: 8236481025658057187, guid: 3c65c5fcec52d6b4e8e210b612078d30, type: 3}
