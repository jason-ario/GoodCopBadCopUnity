    - target: {fileID: 8236481025658057187, guid: 3c65c5fcec52d6b4e8e210b612078d30, type: 3}
      propertyPath: m_text
      value: 'The suspect shows no anomalies and their documents are fully in order.


        Stamp
        PASS and send them through. Incorrectly passing an infected suspect is a
        serious protocol violation.'
      objectReference: {fileID: 0}
