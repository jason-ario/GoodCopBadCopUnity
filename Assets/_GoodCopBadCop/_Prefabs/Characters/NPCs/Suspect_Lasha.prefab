  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1949ab6f68bfe1543878180def30c3a5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DrunkBehaviour
  ShowTopMostFoldoutHeaderGroup: 1
  _drunkChance: 0.25
  _animator: {fileID: 8475456024140496146}
  _drunkAnimatorController: {fileID: 22100000, guid: bccb8bf54e0cb664aa3b06368643210c, type: 2}
  _drunkDialogues:
    earlyDays:
    - Good morning, officer. I just... had a little breakfast. Very liquid breakfast.
      Very early.
    - Papers? Of course. Right here. ...Ah. Right pocket. The right pocket.
    - "I am perfectly fine. The cold air \u2014 it makes my eyes water like this."
    midDays:
    - "You know what I always say \u2014 regulations are like fences. Nobody puts
      up a fence without a reason. ...What were we talking about?"
    - My friend Otar came through here last week. Big man. Smells like cabbage. Did
      you see Otar?
    - I am not drunk. I am just... pre-celebrating. The day has potential.
    finalDays:
    - Do you ever wonder... who checks the people who check the people? I think about
      this a lot now.
    - I have stood in queues my whole life. Queues for bread. Queues for papers.
      Queues for more papers. Today I stand in your queue.
    - Just stamp it. Whatever stamp you use. Any stamp. I am so tired, officer.
--- !u!4 &7633480370597525925 stripped
